---
import { pillars } from '../data/site';

// Same rising series as the hero chart.
const heights = [40, 56, 72, 90];
---

<section class="pillars" id="pillars" aria-labelledby="pillars-title">
  <div class="container">
    <div class="head">
      <h2 id="pillars-title" data-reveal="words">What the forum is for</h2>
      <p data-reveal="fade">Everything BSRF runs serves one of these four aims, the same four on the forum’s founding banner.</p>
    </div>

    <ul class="rows">
      {
        pillars.map((p, i) => (
          <li class="row" style={`--h:${heights[i]}%`} data-reveal="fade">
            <span class="meter" aria-hidden="true">
              <span class="meter-fill" />
            </span>
            <h3>{p.title}</h3>
            <div class="detail">
              <p>{p.body}</p>
              <ul class="examples" aria-label={`Examples of ${p.title.toLowerCase()}`}>
                {p.examples.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pillars {
    padding-block: var(--section);
    background: var(--night);
    color: var(--on-night);
    border-radius: var(--radius-l) var(--radius-l) 0 0;
    position: relative;
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .head h2 {
    font-size: var(--step-4);
    max-width: 12ch;
  }

  .head p {
    font-size: var(--step-1);
    color: var(--on-night-muted);
    max-width: 30rem;
  }

  .rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--night-line);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(1.75rem, 1rem + 2vw, 2.75rem) 0;
    border-bottom: 1px solid var(--night-line);
    isolation: isolate;
  }

  .row::before {
    /* highlight sweeps in from the left on hover */
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    background: linear-gradient(90deg, rgb(35 22 184 / 0.55), rgb(35 22 184 / 0));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
    z-index: -1;
  }

  .row:hover::before {
    transform: scaleX(1);
  }

  .meter {
    position: relative;
    width: 1.1rem;
    height: 4.5rem;
    border-radius: 3px;
    background: var(--night-line);
    overflow: hidden;
    justify-self: start;
  }

  .meter-fill {
    position: absolute;
    inset: auto 0 0;
    height: var(--h);
    background: var(--green);
    border-radius: 3px 3px 0 0;
    transition: height 0.8s var(--ease-out);
  }

  .row:hover .meter-fill {
    height: 100%;
  }

  h3 {
    font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3.1rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.02;
    transition: transform 0.7s var(--ease-out);
  }

  .row:hover h3 {
    transform: translateX(0.6rem);
  }

  .detail {
    display: grid;
    gap: 1rem;
  }

  .detail p {
    color: var(--on-night);
    font-size: 1.05rem;
    max-width: 32rem;
  }

  .examples {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--on-night-muted);
  }

  .examples li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .examples li::before {
    content: '';
    width: 0.5rem;
    height: 0.42rem;
    background: var(--green);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  @media (max-width: 880px) {
    .head {
      grid-template-columns: 1fr;
    }

    .row {
      grid-template-columns: 2rem 1fr;
      align-items: start;
    }

    .meter {
      width: 0.75rem;
      height: 3rem;
      margin-top: 0.2rem;
    }

    .detail {
      grid-column: 2;
    }
  }
</style>
