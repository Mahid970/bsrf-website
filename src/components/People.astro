---
import { Image } from 'astro:assets';
import { people } from '../data/site';

const groups = (['Advisors', 'Executive committee'] as const)
  .map((name) => ({ name, members: people.filter((p) => p.group === name && p.name.trim()) }))
  .filter((g) => g.members.length);
---

<section class="container section" id="people" aria-labelledby="people-title">
  <div class="section-head reveal">
    <div>
      <h2 id="people-title" class="display">People</h2>
      <p>Faculty advisors guide the forum’s research. A student executive committee runs its day-to-day work.</p>
    </div>
  </div>

  {
    groups.map((g) => (
      <div class="group reveal">
        <h3 class="group-title">
          {g.name}
          <span class="score count">{g.members.length}</span>
        </h3>
        <ul class="list">
          {g.members.map((p) => (
            <li class="person panel">
              <span class="avatar">
                {p.photo ? (
                  <Image src={p.photo} alt="" width={128} height={128} />
                ) : (
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="25" r="11" />
                    <path d="M12 56c2.5-11 10.5-17 20-17s17.5 6 20 17Z" />
                  </svg>
                )}
              </span>
              <span class="info">
                <span class="name">{p.name}</span>
                <span class="role">{p.role}</span>
                <span class="detail">{p.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .group + .group {
    margin-top: 2.25rem;
  }

  .group-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-muted);
  }

  .count {
    font-size: 1rem;
    color: var(--brand);
  }

  .list {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .person {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
  }

  .avatar {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 10px;
    overflow: hidden;
    background: var(--brand-wash);
  }

  .avatar svg {
    width: 100%;
    height: 100%;
    fill: var(--brand);
    opacity: 0.35;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    display: grid;
    min-width: 0;
    line-height: 1.35;
  }

  .name {
    font-weight: 600;
  }

  .role {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand);
  }

  .detail {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
</style>
