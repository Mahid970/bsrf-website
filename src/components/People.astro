---
import { Image } from 'astro:assets';
import { people } from '../data/site';

const groups = (['Advisors', 'Executive committee'] as const)
  .map((name) => ({ name, members: people.filter((p) => p.group === name && p.name.trim()) }))
  .filter((g) => g.members.length);
---

<section class="container section" id="people" aria-labelledby="people-title">
  <div class="section-head reveal">
    <div>
      <h2 id="people-title">People</h2>
      <p>Faculty advisors guide the forum’s research. A student executive committee runs its day-to-day work.</p>
    </div>
  </div>

  {
    groups.map((g) => (
      <div class:list={['group', 'reveal', { advisors: g.name === 'Advisors' }]}>
        <h3 class="group-title">{g.name}</h3>
        <ul class="list">
          {g.members.map((p) => (
            <li class="card person hover-lift">
              <span class="avatar">
                {p.photo ? (
                  <Image src={p.photo} alt="" width={192} height={192} />
                ) : (
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="25" r="11" />
                    <path d="M12 56c2.5-11 10.5-17 20-17s17.5 6 20 17Z" />
                  </svg>
                )}
              </span>
              <span class="name">{p.name}</span>
              <span class="chip">{p.role}</span>
              <span class="detail muted">{p.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .group + .group {
    margin-top: 3rem;
  }

  .group-title {
    margin-bottom: 1.1rem;
    font-size: var(--text-base);
    font-weight: 650;
    color: var(--muted);
  }

  /* Three across on wide screens so a committee of six fills two even rows. */
  .list {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 560px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .person {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1.75rem 1.25rem 1.5rem;
    text-align: center;
  }

  .avatar {
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--brand-wash);
    box-shadow: 0 0 0 4px var(--surface), 0 0 0 5px var(--line);
    transition: box-shadow 260ms var(--ease);
  }

  .advisors .avatar {
    width: 6.5rem;
    height: 6.5rem;
  }

  .person:hover .avatar {
    box-shadow: 0 0 0 4px var(--surface), 0 0 0 6px var(--green-bright);
  }

  .avatar svg {
    width: 100%;
    height: 100%;
    fill: var(--brand);
    opacity: 0.35;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .detail {
    font-size: var(--text-sm);
    line-height: 1.45;
  }
</style>
