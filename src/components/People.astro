---
import { Image } from 'astro:assets';
import { people } from '../data/site';

const groups = (['Advisors', 'Executive committee'] as const)
  .map((name) => ({ name, members: people.filter((p) => p.group === name && p.name.trim()) }))
  .filter((g) => g.members.length);
---

<section class="container section" id="people" aria-labelledby="people-title">
  <div class="section-head reveal">
    <div>
      <h2 id="people-title">The people behind the forum</h2>
      <p>Faculty advisors guide the research. A student executive committee runs the forum day to day.</p>
    </div>
  </div>

  {
    groups.map((g) => (
      <div class:list={['group', { advisors: g.name === 'Advisors' }]}>
        <h3 class="group-title reveal">{g.name}</h3>
        <ul class="grid">
          {g.members.map((p) => (
            <li class="person reveal">
              <span class="pic">
                {p.photo ? (
                  <Image src={p.photo} alt="" width={480} height={480} />
                ) : (
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="25" r="11" />
                    <path d="M12 60c2.5-12 10.5-19 20-19s17.5 7 20 19Z" />
                  </svg>
                )}
              </span>
              <span class="name">{p.name}</span>
              <span class="role">{p.role}</span>
              <span class="detail">{p.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .group + .group {
    margin-top: 3.5rem;
  }

  .group-title {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    gap: 2rem 1.5rem;
    list-style: none;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    :not(.advisors) > .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .advisors .grid {
      grid-template-columns: 1fr;
    }
  }

  .person {
    display: grid;
    gap: 0.25rem;
  }

  .pic {
    display: block;
    aspect-ratio: 1 / 1.05;
    margin-bottom: 0.75rem;
    overflow: hidden;
    border-radius: var(--r);
    background: var(--soft);
    transition: background-color 300ms var(--ease);
  }

  .person:hover .pic {
    background: var(--cream);
  }

  .pic svg {
    width: 100%;
    height: 100%;
    fill: var(--ink);
    opacity: 0.12;
    transform: translateY(8%);
    transition: transform 400ms var(--ease);
  }

  .person:hover .pic svg {
    transform: translateY(5%) scale(1.03);
  }

  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    color: var(--ink);
    font-weight: 600;
  }

  .role {
    color: var(--olive-text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .detail {
    font-size: 0.85rem;
    line-height: 1.45;
  }
</style>
