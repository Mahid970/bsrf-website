---
import { Image } from 'astro:assets';
import { people } from '../data/site';

const groups = (['Advisors', 'Executive committee'] as const)
  .map((name) => ({ name, members: people.filter((p) => p.group === name && p.name.trim()) }))
  .filter((g) => g.members.length);
---

<section class="section" id="people" aria-labelledby="people-title">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="people-title" data-reveal>People</h2>
        <p data-reveal>Faculty advisors guide the forum’s research. A student executive committee runs its day-to-day work.</p>
      </div>
    </div>

    {
      groups.map((g) => (
        <div class="group">
          <h3 class="group-title" data-reveal>
            {g.name}
          </h3>
          <ul class:list={['list', { advisors: g.name === 'Advisors' }]}>
            {g.members.map((p) => (
              <li class="person" data-reveal>
                <span class="avatar">
                  {p.photo ? (
                    <Image src={p.photo} alt="" width={160} height={160} />
                  ) : (
                    <svg viewBox="0 0 64 64" aria-hidden="true">
                      <circle cx="32" cy="25" r="11" />
                      <path d="M12 56c2.5-11 10.5-17 20-17s17.5 6 20 17Z" />
                    </svg>
                  )}
                </span>
                <span class="info">
                  <span class="name">{p.name}</span>
                  <span class="role">{p.role}</span>
                  <span class="detail">{p.detail}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .group + .group {
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .group-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--muted);
    padding-bottom: 0.9rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 2.5rem;
    list-style: none;
    padding: 0;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .avatar {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    overflow: hidden;
    background: var(--brand-tint);
  }

  .advisors .avatar {
    width: 5.5rem;
    height: 5.5rem;
  }

  .avatar svg {
    width: 100%;
    height: 100%;
    fill: var(--brand);
    opacity: 0.28;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    display: grid;
    gap: 0.1rem;
    line-height: 1.4;
  }

  .name {
    font-family: var(--font-head);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
  }

  .role {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--green);
  }

  .detail {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .list {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
