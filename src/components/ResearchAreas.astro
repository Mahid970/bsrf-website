---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { researchAreas } from '../data/site';
import { getLaunchPhotos } from '../data/photos';

const photos = await getLaunchPhotos();
const group = photos[10]; // faculty and students cutting the launch cake together
---

<section class="band cream" id="research" aria-labelledby="research-title">
  <div class="container section inner">
    <div class="head reveal">
      <h2 id="research-title">Join a research group in one of six areas</h2>
      <ul class="areas">
        {
          researchAreas.map((a) => (
            <li>
              <a href={`/publications/?area=${encodeURIComponent(a.title)}`}>
                <span class="check" aria-hidden="true">
                  <Icon name="check" size={11} stroke={3} />
                </span>
                {a.title}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="btn btn-lime" href="#join">Become a member</a>
        <a class="btn btn-outline" href="/publications/">See publications</a>
      </div>
    </div>

    <div class="photo group reveal">
      <Image src={group.src} alt={group.alt} widths={[768, 1080, 1440]} sizes="(min-width: 1140px) 1000px, 92vw" />
    </div>
  </div>
</section>

<style>
  .band {
    border-block: 1px solid var(--cream-line);
    padding-bottom: 0;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 3rem;
    padding-bottom: 0;
  }

  .head {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  h2 {
    max-width: 20ch;
    font-size: var(--h2);
  }

  .areas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    max-width: 46rem;
    list-style: none;
    padding: 0;
  }

  .areas a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    font-size: 0.95rem;
    transition: color 200ms var(--ease);
  }

  .areas a:hover {
    text-decoration: underline;
    text-decoration-color: var(--olive);
    text-underline-offset: 0.25em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* The group photo sits on the bottom edge of the band, rounded only at the top. */
  .group {
    width: min(100%, 62rem);
    aspect-ratio: 16 / 7;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }

  .group :global(img) {
    object-position: 50% 35%;
  }
</style>
