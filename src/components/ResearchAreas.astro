---
import { publications, researchAreas } from '../data/site';

const areas = researchAreas.map((a) => {
  const count = publications.filter((p) => p.area === a.title).length;
  return { ...a, count };
});
---

<section class="section section-soft" id="research" aria-labelledby="research-title">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="research-title" data-reveal>Research areas</h2>
        <p data-reveal>Members work in small groups, each guided by a faculty advisor, on six areas of banking, insurance and finance.</p>
      </div>
      <a class="text-link" href="/publications/" data-reveal>See all publications</a>
    </div>

    <ul class="grid">
      {
        areas.map((a) => (
          <li data-reveal>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <span class="count">
              {a.count === 0 ? 'Research in progress' : `${a.count} ${a.count === 1 ? 'publication' : 'publications'}`}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    padding: 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background: var(--bg);
  }

  h3 {
    font-size: var(--step-2);
    line-height: 1.25;
  }

  p {
    color: var(--muted);
    font-size: 0.975rem;
  }

  .count {
    margin-top: auto;
    padding-top: 1rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
