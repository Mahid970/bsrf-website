---
import Icon from './Icon.astro';
import { publications, researchAreas } from '../data/site';

const areas = researchAreas.map((a) => ({
  ...a,
  count: publications.filter((p) => p.area === a.title).length,
  href: `/publications/?area=${encodeURIComponent(a.title)}`,
}));
---

<section class="container section" id="research" aria-labelledby="research-title">
  <div class="section-head reveal">
    <div>
      <h2 id="research-title" class="display">Research areas</h2>
      <p>Members work in small groups, each guided by a faculty advisor.</p>
    </div>
    <a class="link-grow" href="/publications/">See all publications</a>
  </div>

  <ul class="grid reveal">
    {
      areas.map((a) => (
        <li>
          <a class="row-link area" href={a.href}>
            <span class="top">
              <span class="name">
                <Icon name={a.icon} size={18} />
                <span class="display">{a.title}</span>
              </span>
              <span class="score count" aria-label={`${a.count} publications`}>
                {a.count}
              </span>
            </span>
            <span class="body muted">{a.body}</span>
            <span class="foot">
              <span class="muted">{a.count === 1 ? '1 publication' : `${a.count} publications`}</span>
              <span class="row-arrow">
                <Icon name="arrow" size={16} />
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1rem 1.1rem 0.9rem;
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .name {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 1.08rem;
    line-height: 1.2;
  }

  .name :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--brand);
  }

  .name .display {
    font-weight: 600;
    font-stretch: 108%;
  }

  .count {
    font-size: 1.35rem;
    color: var(--ink-muted);
    transition: color 160ms var(--ease);
  }

  .area:hover .count {
    color: var(--brand);
  }

  .body {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: var(--text-xs);
  }
</style>
