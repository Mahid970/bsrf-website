---
import Icon from './Icon.astro';
import { researchAreas } from '../data/site';
---

<section class="area-band" id="research" aria-labelledby="research-title">
  <div class="container section">
    <div class="section-head reveal">
      <div>
        <h2 id="research-title">Research areas</h2>
        <p>Members work in small groups, each guided by a faculty advisor. Pick an area to see its publications.</p>
      </div>
      <a class="link" href="/publications/">All publications</a>
    </div>

    <ul class="grid">
      {
        researchAreas.map((a) => (
          <li class="reveal">
            <a class="card-link area" href={`/publications/?area=${encodeURIComponent(a.title)}`}>
              <span class="icon-dot">
                <Icon name={a.icon} size={20} />
              </span>
              <h3>{a.title}</h3>
              <p class="muted">{a.body}</p>
              <span class="more">
                View publications
                <Icon name="chevron" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* A soft band so the cards read as one set. */
  .area-band {
    background: var(--sunk);
  }

  .grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.35rem;
  }

  h3 {
    margin-top: 0.6rem;
    font-size: var(--text-lg);
  }

  p {
    font-size: 0.975rem;
    line-height: 1.55;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--brand);
  }

  .more :global(svg) {
    transition: transform 260ms var(--ease);
  }

  .area:hover .more :global(svg) {
    transform: translateX(4px);
  }
</style>
