---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { pillars, site } from '../data/site';
import { getLaunchPhotos } from '../data/photos';
import { getEvents } from '../utils/events';
import { dateParts, isoDate } from '../utils/format';

const photos = await getLaunchPhotos();
const photo = photos[10]; // faculty and students together at the launch

const { upcoming } = await getEvents();
const next = upcoming[0];
const nextDate = next ? dateParts(next.data.date) : null;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="panel">
    <div class="grid">
      <div class="copy">
        <p class="kicker enter">
          <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          {`${site.department}, ${site.university}`}
        </p>
        <h1 id="hero-title" class="enter" style="--i:1">Advancing research in banking, insurance and finance</h1>
        <p class="lede enter" style="--i:2">
          {`${site.short} brings faculty members and students together to study Bangladesh’s financial sector, share what they learn and publish what they find.`}
        </p>
        <div class="actions enter" style="--i:3">
          <a class="btn btn-white" href="#join">
            Become a member
            <span class="go"><Icon name="chevron" size={17} /></span>
          </a>
          <a class="btn btn-line" href="#research">Explore our research</a>
        </div>
      </div>

      <div class="media enter" style="--i:2">
        <figure class="photo">
          <Image src={photo.src} alt={photo.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 520px, 92vw" loading="eager" fetchpriority="high" />
        </figure>
        {
          next && nextDate && (
            <a class="next" href={`/events/${next.id}/`}>
              <time class="cal" datetime={isoDate(next.data.date)}>
                <span class="m">{nextDate.month}</span>
                <span class="d">{nextDate.day}</span>
              </time>
              <span class="next-text">
                <span class="next-label">Next event</span>
                <span class="next-title">{next.data.title}</span>
              </span>
              <span class="next-go">
                <Icon name="chevron" size={18} />
              </span>
            </a>
          )
        }
      </div>
    </div>

    <ul class="aims" aria-label="What the forum does">
      {
        pillars.map((p) => (
          <li>
            <Icon name={p.icon} size={20} />
            <span>
              <strong>{p.title}</strong>
              <span class="aim-body">{p.body}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: 0.75rem;
  }

  .panel {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(1.75rem, 1rem + 4vw, 4rem) clamp(1.25rem, 0.5rem + 4vw, 4rem) 0;
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 90% at 100% 0%, var(--navy-2), transparent 60%),
      var(--navy);
    color: var(--on-navy);
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .kicker {
    color: var(--green-bright);
  }

  h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: 1.15rem;
    color: var(--on-navy-muted);
  }

  .actions {
    display: grid;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  @media (min-width: 440px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  .hero :global(:focus-visible) {
    outline-color: #fff;
  }

  /* ---------- photo + next event ---------- */
  .media {
    position: relative;
    padding-bottom: 2.25rem;
  }

  .photo {
    aspect-ratio: 5 / 4;
    border-radius: 22px;
    overflow: hidden;
    background: var(--navy-2);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .media:hover .photo :global(img) {
    transform: scale(1.03);
  }

  .next {
    position: absolute;
    left: clamp(-1.5rem, -2vw, -0.5rem);
    right: 1.5rem;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: 24rem;
    padding: 0.75rem 0.9rem 0.75rem 0.75rem;
    border-radius: 20px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.55);
    transition: transform 320ms var(--ease);
  }

  .next:hover {
    transform: translateY(-3px);
  }

  /* Phones: the card sits under the photo at full width, overlapping its edge. */
  @media (max-width: 640px) {
    .media {
      padding-bottom: 0;
    }

    .next {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      max-width: none;
      margin: -2rem 0.6rem 0;
    }
  }

  .next-text {
    display: grid;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .next-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--green);
  }

  .next-title {
    font-weight: 650;
    line-height: 1.3;
  }

  .next-go {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--brand-wash);
    color: var(--brand);
    transition:
      background-color 220ms var(--ease),
      color 220ms var(--ease),
      transform 260ms var(--ease);
  }

  .next:hover .next-go {
    background: var(--brand);
    color: #fff;
    transform: translateX(2px);
  }

  /* ---------- the four aims ---------- */
  .aims {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-inline: calc(clamp(1.25rem, 0.5rem + 4vw, 4rem) * -1);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--navy-line);
  }

  @media (min-width: 640px) {
    .aims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .aims {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .aims li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1.4rem clamp(1.25rem, 0.5rem + 2vw, 2rem);
    border-top: 1px solid var(--navy-line);
    transition: background-color 260ms var(--ease);
  }

  .aims li:first-child {
    border-top: 0;
  }

  @media (min-width: 640px) {
    .aims li {
      border-top: 0;
    }

    .aims li:nth-child(even) {
      border-left: 1px solid var(--navy-line);
    }

    .aims li:nth-child(n + 3) {
      border-top: 1px solid var(--navy-line);
    }
  }

  @media (min-width: 1024px) {
    .aims li + li {
      border-left: 1px solid var(--navy-line);
    }

    .aims li:nth-child(n + 3) {
      border-top: 0;
    }
  }

  .aims li:hover {
    background: rgb(255 255 255 / 0.04);
  }

  .aims li > :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--green-bright);
    transition: transform 360ms var(--ease);
  }

  .aims li:hover > :global(svg) {
    transform: translateY(-2px) rotate(-6deg);
  }

  .aims strong {
    display: block;
    color: #fff;
    font-weight: 650;
    line-height: 1.3;
  }

  .aim-body {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--on-navy-muted);
  }
</style>
