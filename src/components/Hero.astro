---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { publications, researchAreas, site } from '../data/site';
import { getLaunchPhotos } from '../data/photos';
import { getEvents } from '../utils/events';
import { dateParts, isoDate } from '../utils/format';

const photos = await getLaunchPhotos();
const photo = photos[3]; // full lecture room at the launch

const { upcoming } = await getEvents();
const coming = upcoming.slice(0, 2);

const stats = [
  { icon: 'research', value: researchAreas.length, label: 'Research areas', note: 'each guided by faculty' },
  { icon: 'document', value: publications.length, label: 'Publications', note: 'papers and policy briefs' },
  { icon: 'calendar', value: upcoming.length, label: 'Upcoming events', note: 'seminars and workshops' },
] as const;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="grid">
    <div class="copy">
      <p class="pill rise">
        <span class="pill-dot" aria-hidden="true"></span>
        {`${site.department}, ${site.university}`}
      </p>

      <h1 id="hero-title" class="display title rise" style="--i:1">Advancing research in banking, insurance and finance.</h1>
      <p class="lede rise" style="--i:2">
        {`${site.short} brings faculty members and students together to study Bangladesh’s financial sector, share what they learn and publish what they find.`}
      </p>

      <div class="actions rise" style="--i:3">
        <a class="btn btn-primary" href="#join">
          <Icon name="join" size={17} />
          Become a member
        </a>
        <a class="btn btn-quiet" href="#research">Explore our research</a>
      </div>
    </div>

    <div class="card panel rise" style="--i:2">
      <figure class="photo">
        <Image src={photo.src} alt={photo.alt} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 540px, 92vw" loading="eager" fetchpriority="high" />
        <figcaption class="pill photo-pill">
          <span class="pill-dot" aria-hidden="true"></span>
          {`Launched ${site.foundedLabel}`}
        </figcaption>
      </figure>

      <div class="coming">
        <p class="coming-title">Coming up</p>
        {
          coming.length ? (
            <ul>
              {coming.map((e) => {
                const d = dateParts(e.data.date);
                return (
                  <li>
                    <a class="row-link event-row" href={`/events/${e.id}/`}>
                      <time class="date-tile" datetime={isoDate(e.data.date)}>
                        <span class="month">{d.month}</span>
                        <span class="day score">{d.day}</span>
                      </time>
                      <span class="event-text">
                        <span class="event-title">{e.data.title}</span>
                        <span class="event-meta">{[e.data.kind, e.data.time].filter(Boolean).join(', ')}</span>
                      </span>
                      <span class="row-arrow">
                        <Icon name="arrow" size={18} />
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="muted none">No events scheduled yet. Follow the forum on Facebook for news.</p>
          )
        }
      </div>
    </div>
  </div>

  <dl class="stat-strip reveal">
    {
      stats.map((s) => (
        <div class="stat-tile">
          <span class="watermark" aria-hidden="true">
            <Icon name={s.icon} size={96} />
          </span>
          <span class="icon-tile" aria-hidden="true">
            <Icon name={s.icon} size={20} />
          </span>
          <dt class="stat-label">
            {s.label}
            <span class="muted">{s.note}</span>
          </dt>
          <dd class="score stat-value" data-count={s.value}>
            {s.value}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(3rem, 2rem + 3vw, 4rem);
  }

  .grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  .title {
    margin-top: 1.25rem;
    font-size: clamp(2.25rem, 1.3rem + 4vw, 3.4rem);
  }

  .lede {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--ink-muted);
  }

  .actions {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 420px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
  }

  /* ---------- photo + coming up ---------- */
  .card {
    overflow: hidden;
  }

  .photo {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-sunk);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-pill {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    color: var(--ink);
  }

  .coming {
    padding: 1.1rem 1.1rem 1.2rem;
    border-top: 1px solid var(--hairline);
  }

  .coming-title {
    margin-bottom: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .coming ul {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .event-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.6rem 0.9rem 0.6rem 0.6rem;
  }

  .event-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    flex: 1;
  }

  .event-title {
    font-weight: 600;
    line-height: 1.3;
  }

  .event-meta {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .none {
    font-size: var(--text-sm);
  }

  /* ---------- the figures ---------- */

  /* One bordered strip split into three: the figures belong together. */
  .stat-strip {
    display: grid;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .stat-strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 1.4rem;
    overflow: hidden;
    transition: background-color 220ms var(--ease);
  }

  .stat-tile + .stat-tile {
    border-top: 1px solid var(--hairline);
  }

  @media (min-width: 640px) {
    .stat-tile + .stat-tile {
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }
  }

  /* An amber rule grows along the top of the tile you point at. */
  .stat-tile::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease);
  }

  .watermark {
    position: absolute;
    right: -0.9rem;
    bottom: -1.1rem;
    color: var(--brand);
    opacity: 0.06;
    transform: rotate(-12deg);
    transition:
      transform 420ms var(--ease),
      opacity 220ms var(--ease);
  }

  .watermark :global(svg) {
    stroke-width: 1;
  }

  .stat-value {
    order: 2;
    margin-top: 1.25rem;
    font-size: var(--text-4xl);
    transition: color 200ms var(--ease);
  }

  .stat-label {
    order: 3;
    display: grid;
    gap: 0.1rem;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .stat-label .muted {
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .stat-tile .icon-tile {
    order: 1;
  }

  /* Phones: one compact row of three figures instead of three tall tiles. */
  @media (max-width: 639px) {
    .stat-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stat-tile {
      padding: 1rem 0.85rem;
    }

    .stat-tile + .stat-tile {
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }

    .stat-tile .icon-tile,
    .stat-label .muted,
    .watermark {
      display: none;
    }

    .stat-value {
      margin-top: 0;
      font-size: 2rem;
    }

    .stat-label {
      font-size: var(--text-xs);
      line-height: 1.3;
    }
  }

  .stat-tile:hover {
    background: var(--brand-wash);
  }

  .stat-tile:hover::before {
    transform: scaleX(1);
  }

  .stat-tile:hover .watermark {
    opacity: 0.12;
    transform: rotate(0deg) scale(1.08);
  }

  .stat-tile:hover .icon-tile {
    background: var(--brand);
    color: var(--on-brand);
    transform: rotate(-8deg) scale(1.08);
  }

  .stat-tile:hover .stat-value {
    color: var(--brand);
  }
</style>

<script>
  // Figures count up once, the first time the strip is on screen.
  const values = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (values.length && !reduce && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const start = performance.now();
      const duration = 900;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            run(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );
    values.forEach((el) => io.observe(el));
  }
</script>
