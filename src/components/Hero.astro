---
import { pillars, site } from '../data/site';

const headline = 'Better questions about money, risk and trust.';
const words = headline.split(' ');
/** Final bar heights (% of chart height): a rising series, like the bars in the logo. */
const heights = [40, 56, 72, 90];
const lede = `${site.short} is where faculty members and students of the ${site.department} at the ${site.university} research together, from a first question to a published paper.`;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="gridlines" aria-hidden="true">
    {Array.from({ length: 7 }, () => <span />)}
  </div>

  <div class="hero-inner container">
    <div class="copy">
      <h1 id="hero-title" class="title" aria-label={headline}>
        {
          words.map((w) => (
            <span class="w" aria-hidden="true">
              <span class="w-inner">{w}</span>
            </span>
          ))
        }
      </h1>
      <p class="lede" data-hero-fade>{lede}</p>
      <div class="actions" data-hero-fade>
        <a class="btn btn-primary" href="#join">Join the forum</a>
        <a class="btn btn-link" href="#launch">See the launch</a>
      </div>
    </div>

    <div class="chart" data-chart>
      <svg class="trend" data-trend aria-hidden="true">
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--green)"></path>
          </marker>
        </defs>
        <path class="trend-path" data-trend-path marker-end="url(#arrow)"></path>
        {pillars.map(() => <circle class="node" r="6" data-node />)}
      </svg>

      <ol class="bars" aria-label="The forum's four pillars">
        {
          pillars.map((p, i) => (
            <li class="col" style={`--h:${heights[i]}%`}>
              <button class="bar" type="button" data-bar={i} aria-describedby="hero-tip">
                <span class="visually-hidden">{p.title}</span>
              </button>
              <span class="bar-label" aria-hidden="true">
                {p.short}
              </span>
            </li>
          ))
        }
      </ol>

      <p class="tip" id="hero-tip" data-tip aria-live="polite">
        <strong data-tip-title>Four things the forum does</strong>
        <span data-tip-body>Point at a bar, or tap it, to read more.</span>
      </p>
    </div>
  </div>

  <p class="axis-caption container" data-hero-fade>
    {site.department}, {site.university}. Founded {site.foundedLabel}.
  </p>
</section>

<script type="application/json" id="pillar-data" set:html={JSON.stringify(pillars.map(({ title, body }) => ({ title, body })))} />

<style>
  .hero {
    position: relative;
    min-height: max(40rem, min(100svh, 62rem));
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: 6.5rem;
    isolation: isolate;
  }

  /* Hidden until the entrance timeline starts (see Base.astro); auto-shows after 3s if JS fails. */
  :global(.motion) .hero {
    visibility: hidden;
    animation: hero-fallback 0s 3s forwards;
  }

  @keyframes hero-fallback {
    to {
      visibility: visible;
    }
  }

  /* Horizontal chart gridlines running full-bleed behind everything. */
  .gridlines {
    position: absolute;
    inset: 6rem 0 4.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: -1;
    pointer-events: none;
  }

  .gridlines span {
    display: block;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }

  .gridlines span:last-child {
    height: 2px;
    background: var(--ink);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: 4.75rem;
  }

  .copy {
    padding-bottom: clamp(1rem, 4vh, 3rem);
    align-self: center;
  }

  .title {
    font-size: var(--step-5);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 11ch;
    margin-bottom: 1.75rem;
  }

  .w {
    display: inline-block;
    overflow: clip;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    margin-right: 0.22em;
    vertical-align: top;
  }

  .w-inner {
    display: inline-block;
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 34rem;
    margin-bottom: 2.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .btn {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }

  .btn-primary {
    padding: 1rem 1.6rem;
    color: #fff;
    background: var(--blue);
    border-radius: 999px;
    box-shadow: 0 10px 30px -12px rgb(35 22 184 / 0.7);
    transition:
      background-color 0.25s ease,
      transform 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }

  .btn-primary:hover {
    background: var(--blue-deep);
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -14px rgb(35 22 184 / 0.75);
  }

  .btn-link {
    position: relative;
    padding: 0.4rem 0;
    color: var(--ink);
  }

  .btn-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .btn-link:hover::after {
    transform: scaleX(0);
  }

  .btn-link:hover {
    color: var(--blue);
  }

  /* ---------- chart ---------- */
  .chart {
    position: relative;
    height: clamp(20rem, 58vh, 36rem);
    align-self: end;
  }

  .bars {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 2.2vw, 1.75rem);
    align-items: end;
  }

  .col {
    position: relative;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }

  .bar {
    width: 100%;
    height: var(--h);
    background: var(--blue);
    border-radius: 6px 6px 0 0;
    transform-origin: bottom;
    transition:
      background-color 0.35s ease,
      opacity 0.35s ease;
    position: relative;
  }

  .bar::after {
    /* top highlight, like the light edge on the logo bars */
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    border-radius: 6px 6px 0 0;
    background: rgb(255 255 255 / 0.22);
  }

  .col:nth-child(4) .bar {
    background: var(--blue-deep);
  }

  .chart.is-focused .bar {
    opacity: 0.28;
  }

  .chart.is-focused .bar.is-active {
    opacity: 1;
    background: var(--ink);
  }

  .bar-label {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.9rem);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    color: var(--ink);
    white-space: nowrap;
  }

  .trend {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }

  :global(.js) .trend {
    opacity: 1;
  }

  .trend-path {
    fill: none;
    stroke: var(--green);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node {
    fill: var(--paper);
    stroke: var(--green);
    stroke-width: 3.5;
    transform-box: fill-box;
    transform-origin: center;
  }

  .tip {
    position: absolute;
    top: 0;
    left: 0;
    max-width: 17rem;
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--ink-soft);
    background: var(--surface);
    border-radius: var(--radius-m);
    box-shadow:
      0 1px 0 var(--line),
      0 18px 40px -24px rgb(15 13 69 / 0.45);
    z-index: 3;
  }

  .tip strong {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--ink);
  }

  .axis-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.4rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 880px) {
    .hero {
      min-height: auto;
      padding-top: 6rem;
    }

    .gridlines {
      inset: auto 0 4.5rem;
      height: clamp(17rem, 52vw, 22rem);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      padding-bottom: 4.5rem;
    }

    .copy {
      padding-bottom: 1rem;
    }

    .title {
      max-width: 13ch;
    }

    .chart {
      height: clamp(17rem, 52vw, 22rem);
      margin-top: 5.5rem;
    }

    .tip {
      top: -5.5rem;
      max-width: none;
      right: 0;
    }

    .bar-label {
      font-size: 0.78rem;
    }

    .axis-caption {
      position: static;
      padding-bottom: 1.25rem;
    }
  }
</style>

<script>
  import { gsap, reduceMotion as reduce } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const chart = document.querySelector<HTMLElement>('[data-chart]');
  const svg = document.querySelector<SVGSVGElement>('[data-trend]');
  const path = document.querySelector<SVGPathElement>('[data-trend-path]');
  const nodes = [...document.querySelectorAll<SVGCircleElement>('[data-node]')];
  const bars = [...document.querySelectorAll<HTMLButtonElement>('[data-bar]')];
  const tipTitle = document.querySelector<HTMLElement>('[data-tip-title]');
  const tipBody = document.querySelector<HTMLElement>('[data-tip-body]');
  const pillarData: { title: string; body: string }[] = JSON.parse(
    document.getElementById('pillar-data')?.textContent || '[]',
  );

  if (hero && chart && svg && path && bars.length) {
    /* ---- trend line follows the tops of the bars ---- */
    const points = () => {
      const c = chart.getBoundingClientRect();
      return bars.map((b) => {
        const r = b.getBoundingClientRect();
        return { x: r.left - c.left + r.width / 2, y: r.top - c.top };
      });
    };

    const drawLine = () => {
      const c = chart.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${c.width} ${c.height}`);
      const pts = points();
      const last = pts[pts.length - 1];
      const prev = pts[pts.length - 2];
      // extend past the last bar along the same slope, as an arrow
      const ext = { x: last.x + (last.x - prev.x) * 0.45, y: last.y + (last.y - prev.y) * 0.45 - 6 };
      const lift = 26; // keep the line above the bar tops
      const d = [...pts.map((p) => ({ x: p.x, y: p.y - lift })), { x: ext.x, y: ext.y - lift }]
        .map((p, i) => `${i ? 'L' : 'M'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
        .join(' ');
      path.setAttribute('d', d);
      nodes.forEach((n, i) => {
        n.setAttribute('cx', pts[i].x.toFixed(1));
        n.setAttribute('cy', (pts[i].y - lift).toFixed(1));
      });
    };

    drawLine();
    new ResizeObserver(drawLine).observe(chart);

    /* ---- tooltip ---- */
    const defaultTitle = tipTitle?.textContent ?? '';
    const defaultBody = tipBody?.textContent ?? '';
    const tip = chart.querySelector<HTMLElement>('[data-tip]');

    const show = (i: number | null) => {
      chart.classList.toggle('is-focused', i !== null);
      bars.forEach((b, j) => b.classList.toggle('is-active', j === i));
      if (!tipTitle || !tipBody) return;
      tipTitle.textContent = i === null ? defaultTitle : pillarData[i].title;
      tipBody.textContent = i === null ? defaultBody : pillarData[i].body;
      if (tip && !reduce) gsap.fromTo(tip, { y: 6, opacity: 0.6 }, { y: 0, opacity: 1, duration: 0.4, ease: 'power3.out' });
    };

    bars.forEach((b, i) => {
      b.addEventListener('pointerenter', () => show(i));
      b.addEventListener('focus', () => show(i));
      b.addEventListener('click', () => show(i));
      b.addEventListener('blur', () => show(null));
    });
    chart.addEventListener('pointerleave', () => show(null));

    /* ---- entrance sequence ---- */
    if (!reduce) {
      const len = () => path.getTotalLength();
      const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });
      tl.set(hero, { visibility: 'visible' });
      tl.from('.hero .gridlines span', { scaleX: 0, duration: 1.4, stagger: 0.05, ease: 'power3.inOut' }, 0)
        .from('.hero .w-inner', { yPercent: 110, duration: 1.1, stagger: 0.06 }, 0.15)
        .from('[data-hero-fade]', { y: 24, opacity: 0, duration: 1, stagger: 0.1 }, 0.55)
        .from(bars, { scaleY: 0, duration: 1.3, stagger: 0.12, ease: 'expo.out', onUpdate: drawLine }, 0.35)
        .from('.hero .bar-label', { y: 12, opacity: 0, duration: 0.8, stagger: 0.08 }, 0.8)
        .add(() => {
          drawLine();
          const l = len();
          gsap.fromTo(
            path,
            { strokeDasharray: l, strokeDashoffset: l },
            {
              strokeDashoffset: 0,
              duration: 1.2,
              ease: 'power2.inOut',
              onComplete: () => {
                path.style.strokeDasharray = '';
                path.style.strokeDashoffset = '';
              },
            },
          );
        }, 1.2)
        .from(nodes, { scale: 0, duration: 0.6, stagger: 0.12, ease: 'back.out(3)' }, 1.35)
        .from(tip, { y: 16, opacity: 0, duration: 0.8 }, 1.6);

      /* ---- "live data": bars drift a little while the hero is on screen ---- */
      let visible = true;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(hero);
      const base = bars.map((b) => parseFloat(getComputedStyle(b.parentElement!).getPropertyValue('--h')));
      const drift = () => {
        if (visible && !chart.classList.contains('is-focused')) {
          bars.forEach((b, i) => {
            const target = base[i] + gsap.utils.random(-4, 4);
            gsap.to(b, { height: `${target}%`, duration: 2.2, ease: 'sine.inOut', onUpdate: drawLine });
          });
        }
      };
      tl.add(() => {
        drift();
        window.setInterval(drift, 2600);
      }, '+=0.4');
    }
  }
</script>
