---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLaunchPhotos } from '../data/photos';
import { getEvents } from '../utils/events';
import { formatDate } from '../utils/format';

const photos = await getLaunchPhotos();
const bg = photos[3]; // full lecture room at the launch
const faces = [photos[8], photos[5], photos[6], photos[17]]; // small circles in the glass card

const { upcoming } = await getEvents();
const next = upcoming[0];
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="bg"
    src={bg.src}
    alt=""
    widths={[768, 1080, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="shade" aria-hidden="true"></div>

  <div class="container inner">
    <div class="copy">
      <h1 id="hero-title" class="enter">Advancing research in banking, insurance and finance</h1>
      <p class="lede enter" style="--i:1">
        {`A research platform of faculty members and students of the ${site.department}, ${site.university}.`}
      </p>
      <div class="actions enter" style="--i:2">
        <a class="btn btn-lime" href="#join">Become a member</a>
        <a class="btn btn-outline-light" href="#research">Explore our research</a>
      </div>
    </div>

    {
      next && (
        <a class="glass enter" style="--i:3" href={`/events/${next.id}/`}>
          <span class="faces" aria-hidden="true">
            {faces.map((f) => (
              <Image src={f.src} alt="" width={96} height={96} />
            ))}
          </span>
          <span class="glass-text">
            <span class="glass-label">{`Next event, ${formatDate(next.data.date)}`}</span>
            <span class="glass-title">{next.data.title}</span>
          </span>
          <span class="round round-lime">
            <Icon name="chevron" size={14} />
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(38rem, min(100svh, 56rem));
    padding-top: 6rem;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #1c2416;
  }

  .hero :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    animation: settle 2.4s var(--ease) both;
  }

  @keyframes settle {
    from {
      transform: scale(1.08);
    }
  }

  /* Dark at the bottom-left where the text sits, lighter up top. */
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(10 14 8 / 0.55) 0%, rgb(10 14 8 / 0.15) 35%, rgb(10 14 8 / 0.75) 100%),
      linear-gradient(90deg, rgb(10 14 8 / 0.55) 0%, transparent 65%);
  }

  .inner {
    display: grid;
    gap: 2.5rem;
    align-items: end;
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  @media (min-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  h1 {
    max-width: 17ch;
    color: #fff;
    font-size: var(--h1);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 34rem;
    margin-top: 1.1rem;
    font-size: 1.05rem;
    color: rgb(255 255 255 / 0.85);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero :global(:focus-visible) {
    outline-color: #fff;
  }

  /* ---------- frosted card ---------- */
  .glass {
    justify-self: end;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem 1rem;
    align-items: end;
    width: min(100%, 20rem);
    padding: 1rem 1.1rem 1.1rem;
    border-radius: var(--r);
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.16);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    transition:
      background-color 260ms var(--ease),
      transform 320ms var(--ease);
  }

  .glass:hover {
    background: rgb(255 255 255 / 0.24);
    transform: translateY(-3px);
  }

  .faces {
    grid-column: 1 / -1;
    display: flex;
  }

  .faces :global(img) {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgb(255 255 255 / 0.9);
    transition: transform 300ms var(--ease);
  }

  .faces :global(img + img) {
    margin-left: -0.6rem;
  }

  .glass:hover .faces :global(img) {
    transform: translateY(-2px);
  }

  .glass:hover .faces :global(img + img) {
    margin-left: -0.45rem;
  }

  .glass-text {
    display: grid;
    gap: 0.2rem;
  }

  .glass-label {
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.8);
  }

  .glass-title {
    font-weight: 600;
    line-height: 1.35;
  }

  .glass .round {
    border-color: var(--lime);
  }
</style>
