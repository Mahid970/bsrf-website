---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { getLaunchPhotos } from '../data/photos';
import { getEvents } from '../utils/events';
import { dateParts, isoDate } from '../utils/format';

const photos = await getLaunchPhotos();
const main = photos[0]; // portrait: speaker introducing the chief advisor
const side = [photos[3], photos[16]]; // landscape: full lecture room, faculty panel

const { upcoming } = await getEvents();
const next = upcoming[0];
const nextDate = next ? dateParts(next.data.date) : null;

const lines = ['Advancing research in', 'banking, insurance', 'and finance'];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container grid">
    <div class="copy">
      <h1 id="hero-title" aria-label={lines.join(' ')}>
        {
          lines.map((l) => (
            <span class="line" aria-hidden="true">
              <span class="line-inner">{l}</span>
            </span>
          ))
        }
      </h1>
      <p class="lede" data-hero-fade>
        {`${site.short} brings faculty members and students of the ${site.university} together to study Bangladesh’s financial sector, share what they learn and publish their findings.`}
      </p>
      <div class="actions" data-hero-fade>
        <a class="btn btn-primary" href="#join">Become a member</a>
        <a class="btn btn-secondary" href="#research">Explore our research</a>
      </div>
      <dl class="facts" data-hero-fade>
        <div>
          <dt>Founded</dt>
          <dd>{site.foundedLabel}</dd>
        </div>
        <div>
          <dt>Home</dt>
          <dd>{site.department}</dd>
        </div>
      </dl>
    </div>

    <div class="media">
      <div class="mosaic">
        <figure class="tile tile-main" data-hero-tile>
          <Image src={main.src} alt={main.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 981px) 30vw, 92vw" loading="eager" fetchpriority="high" />
        </figure>
        {
          side.map((p) => (
            <figure class="tile" data-hero-tile>
              <Image src={p.src} alt={p.alt} widths={[400, 640]} sizes="(min-width: 981px) 18vw, 45vw" loading="eager" />
            </figure>
          ))
        }
      </div>

      {
        next && nextDate && (
          <a class="next" href={`/events/${next.id}/`} data-hero-card>
            <span class="next-label">Next event</span>
            <span class="next-body">
              <time class="date" datetime={isoDate(next.data.date)}>
                <span class="date-month">{nextDate.month}</span>
                <span class="date-day">{nextDate.day}</span>
              </time>
              <span class="next-text">
                <span class="next-title">{next.data.title}</span>
                <span class="next-meta">
                  <Icon name="pin" size={15} />
                  {next.data.location}
                </span>
              </span>
            </span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
    isolation: isolate;
  }

  /* Hidden until the entrance timeline starts; shows after 2.5s if scripts fail. */
  :global(.motion) .hero {
    visibility: hidden;
    animation: hero-fallback 0s 2.5s forwards;
  }

  @keyframes hero-fallback {
    to {
      visibility: visible;
    }
  }

  /* Soft panel behind the photos, bleeding to the right edge. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    background: var(--bg-soft);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 33rem;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .facts dd {
    font-weight: 600;
    color: var(--ink);
  }

  /* ---------- photo mosaic ---------- */
  .media {
    position: relative;
  }

  .mosaic {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    aspect-ratio: 5 / 4;
  }

  .tile {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--brand-tint);
  }

  .tile-main {
    grid-row: 1 / -1;
  }

  /* Keep the speaker, not the ceiling, in view. */
  .tile-main :global(img) {
    object-position: 50% 65%;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- next event card ---------- */
  .next {
    position: absolute;
    left: clamp(-2.5rem, -3vw, -1rem);
    bottom: clamp(-2rem, -2.5vw, -1rem);
    width: min(23rem, 72%);
    display: grid;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem 1.25rem;
    background: var(--bg);
    border-radius: var(--radius);
    box-shadow:
      0 0 0 1px var(--line),
      0 24px 48px -28px rgb(20 22 58 / 0.45);
    text-decoration: none;
    transition: box-shadow 0.25s ease;
  }

  .next:hover {
    box-shadow:
      0 0 0 1px var(--brand),
      0 24px 48px -28px rgb(20 22 58 / 0.45);
  }

  .next-label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green);
  }

  .next-body {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .date {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.5rem;
    padding: 0.4rem 0 0.5rem;
    border-radius: var(--radius-s);
    background: var(--brand-tint);
    color: var(--brand);
    line-height: 1.1;
  }

  .date-month {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .date-day {
    font-family: var(--font-head);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .next-text {
    display: grid;
    gap: 0.4rem;
  }

  .next-title {
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .next-meta {
    display: flex;
    gap: 0.35rem;
    align-items: flex-start;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--muted);
  }

  .next-meta :global(svg) {
    flex: none;
    margin-top: 0.1rem;
  }

  @media (max-width: 980px) {
    .hero::before {
      display: none;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .next {
      position: relative;
      left: auto;
      bottom: auto;
      width: auto;
      margin: -2.5rem 1rem 0;
    }
  }

  @media (max-width: 560px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      aspect-ratio: auto;
    }

    .tile-main {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }

    .tile {
      aspect-ratio: 4 / 3;
    }

    .next {
      margin: 0.75rem 0 0;
    }

    .actions {
      flex-direction: column;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !reduceMotion) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.set(hero, { visibility: 'visible' })
      .from(hero.querySelectorAll('.line-inner'), { yPercent: 100, duration: 0.9, stagger: 0.08 }, 0)
      .from(hero.querySelectorAll('[data-hero-fade]'), { y: 14, opacity: 0, duration: 0.7, stagger: 0.08 }, 0.3)
      .fromTo(
        hero.querySelectorAll('[data-hero-tile]'),
        { clipPath: 'inset(0 0 100% 0)' },
        { clipPath: 'inset(0 0 0% 0)', duration: 1, stagger: 0.12, ease: 'power4.inOut' },
        0.1,
      )
      .from(hero.querySelectorAll('[data-hero-tile] img'), { scale: 1.08, duration: 1.4, stagger: 0.12 }, 0.1)
      .from(hero.querySelectorAll('[data-hero-card]'), { y: 20, opacity: 0, duration: 0.8 }, 0.75);
  }
</script>
