---
/** Title block for inner pages. */
interface Props {
  title: string;
  lead?: string;
  back?: { href: string; label: string };
  /** Short label in the pill above the title, e.g. the event type. */
  kind?: string;
}

const { title, lead, back, kind } = Astro.props;
---

<header class="page-header container">
  {
    back && (
      <a class="back link-grow" href={back.href}>
        {back.label}
      </a>
    )
  }
  {
    kind && (
      <p class="pill rise">
        <span class="pill-dot" aria-hidden="true" />
        {kind}
      </p>
    )
  }
  <h1 class="display rise" style="--i:1">{title}</h1>
  {
    lead && (
      <p class="lead muted rise" style="--i:2">
        {lead}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .back {
    font-size: var(--text-sm);
  }

  h1 {
    max-width: 22ch;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.5rem);
  }

  .lead {
    max-width: 44rem;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  }
</style>
