---
/** Title block for inner pages, with a breadcrumb back up the site. */
interface Props {
  title: string;
  lead?: string;
  /** Parent page for the breadcrumb, e.g. Events for an event page. */
  back?: { href: string; label: string };
  /** Category shown as a chip above the title, e.g. the event type. */
  kind?: string;
}

const { title, lead, back, kind } = Astro.props;
---

<header class="page-header container">
  <nav class="crumbs enter" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true">/</span>
    {
      back ? (
        <>
          <a href={back.href}>{back.label}</a>
          <span aria-hidden="true">/</span>
        </>
      ) : null
    }
    <span class="here" aria-current="page">{title}</span>
  </nav>
  {kind && <span class="chip enter">{kind}</span>}
  <h1 class="enter" style="--i:1">{title}</h1>
  {
    lead && (
      <p class="lead muted enter" style="--i:2">
        {lead}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .here {
    max-width: 22rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .crumbs a {
    color: var(--brand);
    font-weight: 600;
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-decoration-color: var(--green-bright);
    text-underline-offset: 0.25em;
  }

  h1 {
    max-width: 20ch;
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .lead {
    max-width: 44rem;
    font-size: 1.15rem;
  }
</style>
