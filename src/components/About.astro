---
import Icon from './Icon.astro';
import { site } from '../data/site';

const items = [
  {
    title: 'Who we are',
    body: `${site.short} is a research platform of faculty members and students of the ${site.department}, ${site.university}. It launched on ${site.foundedLabel} in ${site.firstVenue}.`,
  },
  {
    title: 'Why it matters',
    body: 'Bangladesh’s banks, insurers and regulators need evidence about how finance really works here. The forum gives students the chance to produce it while they learn.',
  },
  {
    title: 'How we support members',
    body: 'Every research group has a faculty advisor. Members get methods workshops, reading circles, help with data and writing, and a place to present their work.',
  },
];
---

<section class="container section about" id="about" aria-labelledby="about-title">
  <div class="intro reveal">
    <h2 id="about-title">A research home inside the department</h2>
    <p>From a first question to a published paper: how students and faculty of the department research together.</p>
    <a class="btn btn-outline" href="#people">Meet the people</a>
  </div>

  <div class="accordion reveal">
    {
      items.map((item, i) => (
        <details name="about" open={i === 0}>
          <summary>
            <span>{item.title}</span>
            <span class="round">
              <Icon name="chevron" size={14} />
            </span>
          </summary>
          <p>{item.body}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  h2 {
    font-size: var(--h2);
    max-width: 14ch;
  }

  .intro p {
    max-width: 30rem;
  }

  .intro .btn {
    margin-top: 0.75rem;
  }

  /* ---------- accordion ---------- */
  .accordion {
    display: grid;
    interpolate-size: allow-keywords;
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  details:last-child {
    border-bottom: 0;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 0;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary .round {
    transform: rotate(90deg);
    transition:
      transform 320ms var(--ease),
      background-color 220ms var(--ease),
      border-color 220ms var(--ease);
  }

  details[open] summary .round {
    transform: rotate(-90deg);
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
  }

  summary:hover .round {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
  }

  details p {
    max-width: 34rem;
    padding-bottom: 1.25rem;
  }

  /* Smooth open and close where the browser supports animating details. */
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 360ms var(--ease),
      content-visibility 360ms allow-discrete;
  }

  details[open]::details-content {
    block-size: auto;
  }
</style>
