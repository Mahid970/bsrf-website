---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { getLaunchPhotos } from '../data/photos';

const photos = await getLaunchPhotos();
const portrait = photos[0]; // speaker introducing the chief advisor
---

<section class="container section about" id="about" aria-labelledby="about-title">
  <div class="text reveal">
    <h2 id="about-title">A research home inside the department</h2>
    <p class="lead">
      {`${site.short} is a research platform of faculty members and students of the ${site.department}, ${site.university}.`}
    </p>
    <p class="muted">
      It gives students a structured way to do research alongside the teachers they learn from. Members choose questions that matter to Bangladesh’s banks, insurers and the people who rely on them, learn the methods to answer them, and share what they find with the department and beyond.
    </p>
    <dl class="facts">
      <div>
        <dt>Founded</dt>
        <dd>{site.foundedLabel}</dd>
      </div>
      <div>
        <dt>Open to</dt>
        <dd>Students and faculty</dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{site.faculty}</dd>
      </div>
    </dl>
    <a class="link" href="#join">How to become a member</a>
  </div>

  <figure class="media reveal">
    <div class="photo">
      <Image src={portrait.src} alt={portrait.alt} widths={[480, 720, 960]} sizes="(min-width: 1024px) 440px, 92vw" />
    </div>
    <figcaption class="card note hover-lift">
      <span class="dot" aria-hidden="true"></span>
      <span>
        <strong>{`Launched on ${site.foundedLabel}`}</strong>
        <span class="muted">{`${site.firstVenue}, ${site.department}`}</span>
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .about {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 5rem;
    }
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  h2 {
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .lead {
    font-size: var(--text-lg);
    line-height: 1.5;
    font-weight: 500;
    max-width: 36rem;
  }

  .text > .muted {
    max-width: 36rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-block: 0.5rem;
    padding: 1.1rem 0;
    border-block: 1px solid var(--line);
    width: 100%;
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--muted);
  }

  dd {
    font-weight: 650;
  }

  /* ---------- photo ---------- */
  .media {
    position: relative;
    padding: 0 0 2rem 1.5rem;
  }

  .photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--sunk);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .note {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    max-width: 18rem;
    padding: 1rem 1.1rem;
    box-shadow: var(--shadow-soft);
  }

  .note strong {
    display: block;
    line-height: 1.3;
  }

  .note .muted {
    display: block;
    font-size: var(--text-sm);
    line-height: 1.45;
    margin-top: 0.15rem;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.4rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--green-bright);
    box-shadow: 0 0 0 4px var(--green-wash);
  }
</style>
