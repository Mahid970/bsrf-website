---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { getLaunchPhotos, homePicks } from '../data/photos';

const hall = (await getLaunchPhotos())[homePicks.about];

const facts = [
  { label: 'Founded', value: site.foundedLabel },
  { label: 'Home', value: `${site.department}, ${site.faculty}, ${site.university}` },
  { label: 'Members', value: 'Faculty members and students of the department' },
  { label: 'First session', value: `${site.firstVenue}, Department of Banking and Insurance` },
];
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
    <h2 id="about-title" class="title" data-reveal="words">A research home inside the department</h2>

    <div class="cols">
      <div class="text" data-reveal-stagger>
        <p>
          {`${site.short} opened on ${site.foundedLabel} in ${site.firstVenue} of the ${site.department}. It gives students a regular, structured way to do research alongside the teachers they learn from.`}
        </p>
        <p>
          Members choose questions that matter to Bangladesh’s banks, insurers and the people who rely on them. They learn the methods to answer those questions, then share what they find with the rest of the department and beyond.
        </p>
      </div>

      <dl class="facts" data-reveal-stagger>
        {
          facts.map((f) => (
            <div class="fact">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="photo">
      <div class="frame" data-reveal="clip">
        <div class="parallax" data-parallax="0.14">
          <Image
            src={hall.src}
            alt={hall.alt}
            layout="full-width"
            sizes="(min-width: 1240px) 1240px, 100vw"
            class="img"
          />
        </div>
      </div>
      <figcaption data-reveal="fade">Students fill {site.firstVenue} for the forum’s first session.</figcaption>
    </figure>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
  }

  .title {
    font-size: var(--step-4);
    max-width: 16ch;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .text {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
  }

  .text p {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .text p:first-child {
    color: var(--ink);
  }

  .facts {
    display: grid;
    border-top: 2px solid var(--ink);
  }

  .fact {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  dd {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .photo {
    display: grid;
    gap: 0.9rem;
  }

  .frame {
    position: relative;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--blue-tint);
  }

  .parallax {
    position: absolute;
    inset: -8% 0;
  }

  .parallax :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 880px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .frame {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-m);
    }
  }

  @media (max-width: 480px) {
    .fact {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
