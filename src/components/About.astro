---
import Icon from './Icon.astro';
import { pillars, site } from '../data/site';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="intro">
      <h2 id="about-title" data-reveal>About the forum</h2>
      <div class="text" data-reveal>
        <p class="lead">
          {`${site.short} is a research platform of faculty members and students of the ${site.department}, ${site.university}. It was launched on ${site.foundedLabel}.`}
        </p>
        <p>
          The forum gives students a structured way to do research alongside the teachers they learn from. Members choose questions that matter to Bangladesh’s banks, insurers and the people who rely on them, learn the methods to answer them, and share their findings with the department and beyond.
        </p>
      </div>
    </div>

    <ul class="pillars" aria-label="What the forum does">
      {
        pillars.map((p) => (
          <li data-reveal>
            <span class="icon-wrap">
              <Icon name={p.icon} size={26} />
            </span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    margin-bottom: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  h2 {
    font-size: var(--step-4);
  }

  .text {
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
  }

  .lead {
    font-family: var(--font-head);
    font-size: var(--step-2);
    line-height: 1.45;
    color: var(--ink);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .pillars li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 2rem 1.75rem 0.5rem;
  }

  @media (min-width: 981px) {
    .pillars li:first-child {
      padding-left: 0;
    }

    .pillars li + li {
      border-left: 1px solid var(--line);
    }
  }

  .icon-wrap {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand);
  }

  h3 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .pillars p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillars li {
      padding: 1.75rem 1.5rem 1.5rem 0;
      border-bottom: 1px solid var(--line);
    }

    .pillars li:nth-child(even) {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: 1fr;
    }

    .pillars li,
    .pillars li:nth-child(even) {
      padding: 1.5rem 0;
      border-left: 0;
    }
  }
</style>
