---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { pillars, site } from '../data/site';
---

<section class="band" id="about" aria-labelledby="about-title">
  <div class="container section grid">
    <div class="intro reveal">
      <span class="badge" aria-hidden="true">
        <Image src={mark} alt="" width={40} height={40} densities={[1, 2]} />
      </span>
      <h2 id="about-title" class="display">About the forum</h2>
      <p class="muted measure">
        {`${site.short} is a research platform of faculty members and students of the ${site.department}, ${site.university}, launched on ${site.foundedLabel}.`}
      </p>
      <p class="muted measure">
        Members choose questions that matter to Bangladesh’s banks, insurers and the people who rely on them, learn the methods to answer them, and share what they find.
      </p>
      <a class="link-grow" href="#join">How membership works</a>
    </div>

    <ul class="aims reveal" aria-label="What the forum does">
      {
        pillars.map((p) => (
          <li class="aim panel">
            <span class="icon-tile">
              <Icon name={p.icon} size={20} />
            </span>
            <h3 class="display">{p.title}</h3>
            <p class="muted">{p.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: 3.5rem;
    }
  }

  .intro {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.9rem;
  }

  /* The forum's mark, set on a tile that sits on a hard amber shadow. */
  .badge {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.4rem;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--hairline);
    box-shadow: 4px 4px 0 var(--amber);
  }

  .badge :global(img) {
    width: 40px;
    height: 40px;
  }

  h2 {
    font-size: var(--text-3xl);
  }

  .aims {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .aims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .aim {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem;
    transition:
      border-color 200ms var(--ease),
      box-shadow 260ms var(--ease),
      translate 260ms var(--ease);
  }

  .aim h3 {
    margin-top: 0.5rem;
    font-size: 1.1rem;
    line-height: 1.2;
  }

  .aim p {
    font-size: 0.95rem;
  }

  .aim:hover {
    border-color: var(--brand);
    box-shadow: 4px 4px 0 var(--brand);
    translate: -2px -2px;
  }

  .aim:hover .icon-tile {
    background: var(--brand);
    color: var(--on-brand);
  }

  .aim:hover .icon-tile :global(svg) {
    animation: icon-wiggle 520ms var(--ease);
  }
</style>
