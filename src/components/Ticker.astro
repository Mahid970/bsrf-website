---
import { researchAreas } from '../data/site';
---

<section class="ticker" aria-label="Research areas">
  <p class="label">Research areas</p>
  <div class="viewport" data-ticker>
    <ul class="track" data-ticker-track>
      {
        [0, 1].map((copy) =>
          researchAreas.map((area) => (
            <li aria-hidden={copy === 1 ? 'true' : undefined}>
              <svg class="up" viewBox="0 0 10 8" aria-hidden="true">
                <path d="M5 0 L10 8 L0 8 Z" />
              </svg>
              {area}
            </li>
          )),
        )
      }
    </ul>
  </div>
</section>

<style>
  .ticker {
    position: relative;
    display: flex;
    align-items: stretch;
    background: var(--night);
    color: var(--on-night);
    font-family: var(--font-ui);
    overflow: hidden;
  }

  .label {
    position: relative;
    z-index: 1;
    flex: none;
    display: flex;
    align-items: center;
    padding: 0 1.25rem 0 var(--gutter);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--night);
    background: var(--green);
  }

  .label::after {
    /* slanted edge, like a ticker tab */
    content: '';
    position: absolute;
    left: 100%;
    top: 0;
    bottom: 0;
    width: 1.25rem;
    background: var(--green);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .viewport {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
  }

  .track {
    display: flex;
    width: max-content;
    list-style: none;
    padding: 1.15rem 0;
    animation: ticker 48s linear infinite;
  }

  .ticker:hover .track {
    animation-play-state: paused;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0 1.6rem;
    font-size: 1.15rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .up {
    width: 0.7rem;
    height: 0.6rem;
    fill: var(--green);
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .label {
      display: none;
    }

    li {
      font-size: 1rem;
      padding: 0 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }

    li[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  import { lenis, reduceMotion } from '../scripts/motion';

  // Speed the ticker up while the page is being scrolled, then ease back.
  const track = document.querySelector<HTMLElement>('[data-ticker-track]');
  const anim = track?.getAnimations()[0];

  if (anim && lenis && !reduceMotion) {
    let rate = 1;
    lenis.on('scroll', ({ velocity }: { velocity: number }) => {
      rate = Math.min(6, 1 + Math.abs(velocity) * 0.25);
    });
    const tick = () => {
      const current = anim.playbackRate;
      anim.playbackRate = current + (rate - current) * 0.08;
      rate += (1 - rate) * 0.05;
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
