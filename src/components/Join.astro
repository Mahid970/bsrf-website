---
import Icon from './Icon.astro';
import { site, steps } from '../data/site';

const applyHref = site.joinFormUrl || site.facebook;
const applyLabel = site.joinFormUrl ? 'Fill in the membership form' : 'Apply on Facebook';
---

<section class="join" id="join" aria-labelledby="join-title">
  <div class="container section grid">
    <div class="intro reveal">
      <p class="kicker">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        Membership
      </p>
      <h2 id="join-title">Becoming a member</h2>
      <p class="muted">
        {`Open to students and faculty of the ${site.department}. You don’t need research experience: the forum teaches the methods as you go.`}
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={applyHref} target="_blank" rel="noopener">
          {applyLabel}
          <span class="go"><Icon name="chevron" size={17} /></span>
        </a>
        {
          site.email && (
            <a class="btn btn-ghost" href={`mailto:${site.email}`}>
              <Icon name="mail" size={17} />
              Email the forum
            </a>
          )
        }
      </div>
    </div>

    <ol class="steps reveal">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <div class="step-text">
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .join {
    background: linear-gradient(180deg, var(--bg), var(--green-wash));
  }

  .grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 5rem;
    }
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .intro {
      position: sticky;
      top: 7rem;
    }
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .intro .muted {
    max-width: 30rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  /* ---------- steps: numbered circles on one line ---------- */
  .steps {
    position: relative;
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .steps::before {
    content: '';
    position: absolute;
    left: calc(1.25rem + 1.5rem - 1px);
    top: 2.5rem;
    bottom: 2.5rem;
    width: 2px;
    background: linear-gradient(var(--brand), var(--green-bright));
    opacity: 0.35;
  }

  .step {
    position: relative;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--r);
    transition:
      background-color 260ms var(--ease),
      border-color 260ms var(--ease),
      box-shadow 260ms var(--ease);
  }

  .step:hover {
    background: var(--surface);
    border-color: var(--line);
    box-shadow: var(--shadow-soft);
  }

  .num {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid var(--brand);
    background: var(--surface);
    color: var(--brand);
    font-weight: 800;
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
    transition:
      background-color 260ms var(--ease),
      color 260ms var(--ease),
      transform 360ms var(--ease);
  }

  .step:hover .num {
    background: var(--brand);
    color: #fff;
    transform: scale(1.06);
  }

  :global(:root[data-theme='dark']) .step:hover .num {
    color: #0b0d24;
  }

  .step-text {
    padding-top: 0.3rem;
  }

  h3 {
    font-size: var(--text-lg);
  }

  .step-text p {
    margin-top: 0.35rem;
    max-width: 30rem;
  }
</style>
