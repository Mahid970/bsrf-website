---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, steps } from '../data/site';
import { getLaunchPhotos } from '../data/photos';

const photos = await getLaunchPhotos();
const icons = ['join', 'users', 'knowledge', 'document'] as const;
const cards = steps.map((s, i) => ({ ...s, icon: icons[i], num: String(i + 1).padStart(2, '0') }));
// Steps run 1–2 then a photo on the left, a photo then 3–4 on the right.
const left = { steps: cards.slice(0, 2), photo: photos[5] };
const right = { steps: cards.slice(2), photo: photos[8] };
const applyHref = site.joinFormUrl || site.facebook;
const applyLabel = site.joinFormUrl ? 'Fill in the membership form' : 'Apply on Facebook';
---

<section class="container section" id="join" aria-labelledby="join-title">
  <div class="section-head center reveal">
    <h2 id="join-title">How BSRF membership works</h2>
  </div>

  <div class="cols">
    <div class="col">
      {
        left.steps.map((s) => (
          <div class="step cream reveal">
            <span class="icon">
              <Icon name={s.icon} size={26} />
            </span>
            <span class="text">
              <h3>{s.title}</h3>
              <span class="body">{s.body}</span>
            </span>
            <span class="num" aria-hidden="true">
              {s.num}
            </span>
          </div>
        ))
      }
      <div class="photo tall reveal">
        <Image src={left.photo.src} alt={left.photo.alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 540px, 92vw" />
      </div>
    </div>

    <div class="col">
      <div class="photo tall reveal">
        <Image src={right.photo.src} alt={right.photo.alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 540px, 92vw" />
      </div>
      {
        right.steps.map((s) => (
          <div class="step cream reveal">
            <span class="icon">
              <Icon name={s.icon} size={26} />
            </span>
            <span class="text">
              <h3>{s.title}</h3>
              <span class="body">{s.body}</span>
            </span>
            <span class="num" aria-hidden="true">
              {s.num}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="apply reveal">
    <a class="btn btn-lime" href={applyHref} target="_blank" rel="noopener">{applyLabel}</a>
    {
      site.email && (
        <a class="btn btn-outline" href={`mailto:${site.email}`}>
          Email the forum
        </a>
      )
    }
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--r);
    border: 1px solid var(--cream-line);
    transition:
      border-color 260ms var(--ease),
      transform 320ms var(--ease),
      box-shadow 320ms var(--ease);
  }

  .step:hover {
    border-color: var(--olive);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .icon {
    flex-shrink: 0;
    color: var(--ink);
    transition: transform 360ms var(--ease);
  }

  .step:hover .icon {
    transform: rotate(-8deg) scale(1.08);
  }

  .text {
    display: grid;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }

  h3 {
    font-size: 1.1rem;
  }

  .body {
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .num {
    flex-shrink: 0;
    color: var(--olive);
    font-size: 1.6rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .apply {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .tall {
    aspect-ratio: 16 / 9.5;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
