---
import Icon from './Icon.astro';
import { site, steps } from '../data/site';

const applyHref = site.joinFormUrl || site.facebook;
const applyLabel = site.joinFormUrl ? 'Fill in the membership form' : 'Apply on Facebook';
const stepIcons = ['join', 'users', 'knowledge', 'document'] as const;
---

<section class="container section" id="join" aria-labelledby="join-title">
  <div class="section-head reveal">
    <div>
      <h2 id="join-title" class="display">Four steps to membership</h2>
      <p>{`Open to students and faculty of the ${site.department}. No research experience needed.`}</p>
    </div>
  </div>

  <ol class="track">
    {
      steps.map((s, i) => (
        <li class="step reveal">
          <span class="numeral" aria-hidden="true">
            {i + 1}
          </span>
          <span class="step-head">
            <span class="icon-tile">
              <Icon name={stepIcons[i]} size={20} />
            </span>
            <span class="step-label">{`Step ${i + 1}`}</span>
          </span>
          <h3 class="display">{s.title}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))
    }
  </ol>

  <div class="cta reveal">
    <div>
      <h3 class="display">Ready to join?</h3>
      <p>Send us a message and a committee member will get back to you.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-light" href={applyHref} target="_blank" rel="noopener">
        <Icon name="join" size={17} />
        {applyLabel}
      </a>
      {
        site.email && (
          <a class="btn btn-outline" href={`mailto:${site.email}`}>
            <Icon name="mail" size={17} />
            Email the forum
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .track {
    position: relative;
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    /* A dashed thread through the icons says these happen in order. */
    .track::before {
      content: '';
      position: absolute;
      top: 2.75rem;
      left: 3rem;
      right: 3rem;
      border-top: 2px dashed var(--hairline);
    }
  }

  .step {
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color 200ms var(--ease),
      box-shadow 260ms var(--ease),
      translate 260ms var(--ease);
  }

  /* The step number, huge and faint, carries the sequence. */
  .numeral {
    position: absolute;
    top: -1.4rem;
    right: 0.6rem;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: 7.5rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--hairline);
    pointer-events: none;
    transition:
      -webkit-text-stroke-color 260ms var(--ease),
      translate 360ms var(--ease);
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .step h3 {
    margin-top: 1rem;
    font-size: var(--text-lg);
  }

  .step p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .step:hover {
    border-color: var(--brand);
    box-shadow: 4px 4px 0 var(--brand);
    translate: -2px -2px;
  }

  .step:hover .numeral {
    -webkit-text-stroke-color: var(--amber);
    translate: 0 4px;
  }

  .step:hover .icon-tile {
    background: var(--brand);
    color: var(--on-brand);
    transform: scale(1.1);
  }

  .step:hover .icon-tile :global(svg) {
    animation: icon-wiggle 520ms var(--ease);
  }

  /* ---------- call to action ---------- */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--brand);
    color: var(--on-brand);
    box-shadow: 6px 6px 0 var(--amber);
  }

  .cta h3 {
    font-size: var(--text-2xl);
  }

  .cta p {
    margin-top: 0.4rem;
    opacity: 0.8;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-light {
    background: var(--on-brand);
    color: var(--brand);
  }

  .btn-outline {
    --lift: var(--on-brand);
    color: var(--on-brand);
    border-color: color-mix(in srgb, var(--on-brand) 40%, transparent);
  }

  .btn-outline:hover {
    border-color: var(--on-brand);
  }

  .cta :global(:focus-visible) {
    outline-color: var(--on-brand);
  }

  @media (max-width: 520px) {
    .cta-actions {
      display: grid;
      width: 100%;
    }
  }
</style>
