---
import { site, steps } from '../data/site';

const joinHref = site.joinFormUrl || site.facebook;
const joinLabel = site.joinFormUrl ? 'Fill in the membership form' : 'Message us on Facebook';
---

<section class="steps" id="join" aria-labelledby="join-title">
  <div class="container">
    <div class="head">
      <h2 id="join-title" data-reveal="words">How membership works</h2>
      <p data-reveal="fade">Open to students and faculty of the {site.department}. No research experience needed.</p>
    </div>

    <div class="timeline-wrap" data-timeline>
      <span class="track" aria-hidden="true"><span class="track-fill" data-track-fill></span></span>
      <ol class="timeline">
      {
        steps.map((s, i) => (
          <li class="step" data-step>
            <span class="node" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
      </ol>
    </div>

    <div class="cta" data-reveal="fade">
      <a class="btn-join" href={joinHref} target="_blank" rel="noopener">{joinLabel}</a>
      {site.email && <a class="btn-mail" href={`mailto:${site.email}`}>{site.email}</a>}
    </div>
  </div>
</section>

<style>
  .steps {
    padding-block: 0 var(--section);
    background: var(--night);
    color: var(--on-night);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: end;
    padding-top: var(--section);
    margin-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .head h2 {
    font-size: var(--step-4);
    max-width: 12ch;
  }

  .head p {
    font-size: var(--step-1);
    color: var(--on-night-muted);
    max-width: 30rem;
  }

  .timeline-wrap {
    position: relative;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    list-style: none;
    padding: 0;
  }

  .track {
    position: absolute;
    left: 1.5rem;
    right: 0;
    top: 1.5rem;
    height: 2px;
    background: var(--night-line);
  }

  .track-fill {
    position: absolute;
    inset: 0;
    background: var(--green);
    transform-origin: left;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .node {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--night);
    background: var(--green);
    box-shadow: 0 0 0 6px var(--night);
    position: relative;
    z-index: 1;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 650;
  }

  .step p {
    color: var(--on-night-muted);
    max-width: 22rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--night-line);
  }

  .btn-join {
    padding: 1rem 1.6rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--night);
    background: var(--green);
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.25s ease;
  }

  .btn-join:hover {
    background: #5fd6a7;
    transform: translateY(-3px);
  }

  .btn-mail {
    font-family: var(--font-ui);
    color: var(--on-night);
  }

  @media (max-width: 880px) {
    .head {
      grid-template-columns: 1fr;
    }

    .timeline {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-left: 4.5rem;
    }

    .track {
      left: 1.5rem;
      top: 0.5rem;
      bottom: 0;
      width: 2px;
      height: auto;
    }

    .track-fill {
      transform-origin: top;
    }

    .node {
      position: absolute;
      left: -4.5rem;
      top: -0.4rem;
      margin: 0;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = document.querySelector<HTMLElement>('[data-track-fill]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-step]')];

  if (timeline && fill && !reduceMotion) {
    const mm = gsap.matchMedia();
    mm.add({ wide: '(min-width: 881px)', narrow: '(max-width: 880px)' }, (ctx) => {
      const wide = ctx.conditions?.wide;
      // The green line fills as the timeline scrolls through the viewport.
      gsap.fromTo(
        fill,
        wide ? { scaleX: 0, scaleY: 1 } : { scaleY: 0, scaleX: 1 },
        {
          ...(wide ? { scaleX: 1 } : { scaleY: 1 }),
          ease: 'none',
          scrollTrigger: { trigger: timeline, start: 'top 75%', end: wide ? 'top 25%' : 'bottom 60%', scrub: 0.6 },
        },
      );
      // Each step lights up as the line reaches it.
      items.forEach((item, i) => {
        gsap.from(item, {
          opacity: 0.25,
          y: 24,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: wide ? timeline : item,
            start: wide ? `top ${75 - i * 12}%` : 'top 78%',
            toggleActions: 'play none none reverse',
          },
        });
        gsap.from(item.querySelector('.node'), {
          scale: 0.4,
          duration: 0.7,
          ease: 'back.out(2.5)',
          scrollTrigger: {
            trigger: wide ? timeline : item,
            start: wide ? `top ${75 - i * 12}%` : 'top 78%',
            toggleActions: 'play none none reverse',
          },
        });
      });
    });
  }
</script>
