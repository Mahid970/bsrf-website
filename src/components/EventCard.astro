---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { EventEntry } from '../utils/events';
import { dateParts, formatDate, isoDate } from '../utils/format';

interface Props {
  entry: EventEntry;
}

const { entry } = Astro.props;
const { title, kind, date, summary, cover, time } = entry.data;
const d = dateParts(date);
---

<a class="card" href={`/events/${entry.id}/`}>
  <span class="photo media" style={`view-transition-name: cover-${entry.id}`}>
    {
      cover ? (
        <Image src={cover} alt="" widths={[400, 640, 800]} sizes="(min-width: 900px) 360px, 92vw" />
      ) : (
        <span class="tile cream">
          <span class="tile-day">{d.day}</span>
          <span class="tile-month">{d.month}</span>
          <span class="tile-kind">{kind}</span>
        </span>
      )
    }
  </span>
  <span class="meta">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    {time && <span>{time}</span>}
  </span>
  <h3>{title}</h3>
  <span class="summary">{summary}</span>
  <span class="more">
    Read more
    <Icon name="chevron" size={15} />
  </span>
</a>

<style>
  .card {
    display: grid;
    gap: 0.6rem;
  }

  .media {
    aspect-ratio: 16 / 10.5;
    margin-bottom: 0.5rem;
  }

  /* Events without photos get a calendar tile in the cream colour. */
  .tile {
    display: grid;
    place-content: center;
    justify-items: center;
    height: 100%;
    border: 1px solid var(--cream-line);
    border-radius: var(--r);
    color: var(--ink);
    transition: background-color 300ms var(--ease);
  }

  .card:hover .tile {
    background: color-mix(in srgb, var(--lime) 35%, var(--cream));
  }

  .tile-day {
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .tile-month {
    font-size: 1rem;
    font-weight: 600;
  }

  .tile-kind {
    margin-top: 0.75rem;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: var(--lime);
    color: var(--on-lime);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  h3 {
    font-size: 1.2rem;
  }

  .summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.95rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .more :global(svg) {
    transition: transform 260ms var(--ease);
  }

  .card:hover .more :global(svg) {
    transform: translateX(3px);
  }
</style>
