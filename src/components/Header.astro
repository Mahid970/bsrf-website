---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="lockup" href="/" aria-label="BankSure Scientific Research Forum, home">
      <span class="mark">
        <Image src={mark} alt="" width={44} height={44} densities={[1, 2]} loading="eager" />
      </span>
      <span class="wordmark">
        <span>BankSure Scientific</span>
        <span>Research Forum</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a class="nav-link" href={item.href} data-active={isCurrent(item.href) ? 'true' : undefined} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between light and dark theme">
        <span class="to-dark"><Icon name="moon" size={18} /></span>
        <span class="to-light"><Icon name="sun" size={18} /></span>
      </button>
      <a class="btn btn-primary btn-compact join" href="/#join">
        <Icon name="join" size={16} />
        Join
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      {
        nav.map((item) => (
          <a class="m-link" href={item.href}>
            {item.label}
            <Icon name="chevron" size={18} />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--ground) 97%, transparent);
    transition: box-shadow 240ms var(--ease);
  }

  @media (min-width: 768px) {
    .site-header {
      background: color-mix(in srgb, var(--ground) 85%, transparent);
      backdrop-filter: saturate(160%) blur(10px);
      -webkit-backdrop-filter: saturate(160%) blur(10px);
    }
  }

  /* The bar lifts off the page once there is something beneath it. */
  :global(:root[data-scrolled='true']) .site-header {
    box-shadow: 0 8px 20px -14px color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4.25rem;
  }

  @media (min-width: 640px) {
    .bar {
      height: 5rem;
    }
  }

  /* ---------- lockup ---------- */
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    color: var(--ink);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    transition: transform 260ms var(--ease);
  }

  .mark :global(img) {
    width: 44px;
    height: 44px;
  }

  /* The mark is dark blue, so it sits on a white tile in the dark theme. */
  :global(:root[data-theme='dark']) .mark {
    background: #fff;
  }

  :global(:root[data-theme='dark']) .mark :global(img) {
    width: 36px;
    height: 36px;
  }

  .lockup:hover .mark {
    transform: translateY(-1px) scale(1.03);
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.02rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* ---------- links ---------- */
  .nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink-muted);
    transition:
      color 160ms var(--ease),
      background-color 160ms var(--ease);
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--surface-sunk);
  }

  .nav-link[data-active='true'] {
    color: var(--ink);
    font-weight: 700;
  }

  /* The current page keeps a rule under it; hovering draws one in from the left. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[data-active='true']::after {
    transform: scaleX(1);
  }

  /* ---------- tools ---------- */
  .tools {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 8px;
    color: var(--ink-muted);
    transition: color 160ms var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
  }

  .theme-toggle :global(svg) {
    transition: transform 300ms var(--ease);
  }

  .theme-toggle:hover :global(svg) {
    transform: rotate(-18deg);
  }

  .to-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .to-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .to-light {
    display: block;
  }

  .join {
    margin-left: 0.35rem;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-left: 0.25rem;
    border-radius: 8px;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .burger {
    display: grid;
    gap: 5px;
    width: 16px;
  }

  .burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 260ms var(--ease);
  }

  .menu-open .burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-open .burger span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (min-width: 900px) {
    .nav {
      display: flex;
    }

    .tools {
      margin-left: 0.5rem;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .wordmark {
      font-size: 0.9rem;
    }

    .join {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.5rem 0 1rem;
    background: var(--ground);
    border-bottom: 1px solid var(--hairline);
    box-shadow: 0 20px 30px -24px color-mix(in srgb, var(--ink) 45%, transparent);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 320ms var(--ease);
  }

  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }

  .menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }

  .mobile-menu nav {
    display: grid;
    gap: 0.4rem;
  }

  .m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    font-weight: 600;
  }

  .m-link :global(svg) {
    color: var(--ink-muted);
  }
</style>

<script>
  // Lift the bar once the page has scrolled: one attribute flip, not one per scroll event.
  const root = document.documentElement;
  let lifted: boolean | null = null;
  const update = () => {
    const next = window.scrollY > 8;
    if (next !== lifted) {
      lifted = next;
      if (next) root.dataset.scrolled = 'true';
      else delete root.dataset.scrolled;
    }
  };
  update();
  window.addEventListener('scroll', update, { passive: true });

  // Theme: stored on this device only; light unless dark was chosen here.
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    if (next === 'dark') root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('bsrf_theme', next);
    } catch {
      // Private browsing or blocked storage: the switch still works for this visit.
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0f1017' : '#f2f2f0');
  });

  // Mobile menu.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      if (open) menu.hidden = false;
      else
        window.setTimeout(() => {
          if (!open) menu.hidden = true;
        }, 320);
    };

    toggle.addEventListener('click', () => setOpen(!open));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }
</script>
