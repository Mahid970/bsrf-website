---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<div class="utility">
  <div class="container utility-inner">
    <p>{`${site.department}, ${site.university}`}</p>
    <ul>
      {
        site.email && (
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="mail" size={16} />
              {site.email}
            </a>
          </li>
        )
      }
      <li>
        <a href={site.facebook} target="_blank" rel="noopener">
          <Icon name="facebook" size={16} />
          Facebook
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={mark} alt="" width={48} height={48} densities={[1, 2]} loading="eager" class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-sub">{site.university}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn-primary cta" href="/#join">Become a member</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Open menu</span>
      <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary mobile-cta" href="/#join">Become a member</a>
    </nav>
  </div>
</header>

<style>
  /* ---------- utility bar ---------- */
  .utility {
    background: var(--navy);
    color: var(--on-navy-muted);
    font-size: 0.8125rem;
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.25rem;
  }

  .utility ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .utility a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--on-navy);
  }

  .utility a:hover {
    text-decoration: underline;
  }

  /* ---------- main bar ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 24px -18px rgb(20 22 58 / 0.5);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
  }

  .brand-mark {
    width: 48px;
    height: 48px;
    flex: none;
  }

  .brand-text {
    display: grid;
    line-height: 1.2;
  }

  .brand-name {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .brand-sub {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }

  .nav a {
    position: relative;
    display: block;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.15rem;
    height: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav a[aria-current='page'] {
    color: var(--brand);
  }

  /* ---------- mobile ---------- */
  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: var(--radius-s);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .burger {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .burger span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition:
      transform 0.3s var(--ease-out),
      opacity 0.2s ease;
  }

  .menu-open .burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-open .burger span:nth-child(2) {
    opacity: 0;
  }

  .menu-open .burger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -30px rgb(20 22 58 / 0.5);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.4s var(--ease-in-out);
  }

  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }

  .menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0.5rem 0;
  }

  .mobile-menu li + li {
    border-top: 1px solid var(--line);
  }

  .mobile-menu li a {
    display: block;
    padding: 0.95rem 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .mobile-cta {
    width: 100%;
    margin: 0.5rem 0 1.5rem;
  }

  @media (max-width: 1100px) {
    .nav ul {
      gap: 1.25rem;
    }

    .brand-name {
      font-size: 0.975rem;
    }
  }

  @media (max-width: 980px) {
    .nav,
    .bar > .cta {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }

  @media (max-width: 640px) {
    .utility ul {
      display: none;
    }

    .bar {
      min-height: 4.25rem;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
    }

    .brand-name {
      font-size: 0.9rem;
    }

    .brand-sub {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      if (open) {
        menu.hidden = false;
      } else {
        window.setTimeout(() => {
          if (!open) menu.hidden = true;
        }, 400);
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 981px)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }
</script>
