---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

interface Props {
  /** Starts transparent with white text over a full-bleed photo. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class:list={['site-header', { overlay }]} data-header>
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${site.name}, home`}>
      <span class="mark">
        <Image src={mark} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
      </span>
      <span class="word">{site.short}</span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button type="button" class="theme" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
        <span class="sun"><Icon name="sun" size={18} /></span>
        <span class="moon"><Icon name="moon" size={18} /></span>
      </button>
      <a class="btn btn-lime btn-sm cta" href="/#join">Become a member</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      {
        nav.map((item) => (
          <a class="m-link" href={item.href}>
            {item.label}
            <span class="round">
              <Icon name="chevron" size={14} />
            </span>
          </a>
        ))
      }
      <a class="btn btn-lime m-cta" href="/#join">Become a member</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 280ms var(--ease),
      border-color 280ms var(--ease),
      color 280ms var(--ease);
  }

  @media (min-width: 768px) {
    .site-header {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  /* Over the opening photo: transparent, white text, a faint white rule. */
  .overlay {
    position: fixed;
    left: 0;
    right: 0;
    color: #fff;
    background: transparent;
    border-bottom-color: rgb(255 255 255 / 0.22);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  /* Once the page scrolls past the top it turns into the normal solid bar. */
  :global(:root[data-scrolled='true']) .overlay,
  .overlay.menu-open {
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-bottom-color: var(--line);
  }

  @media (min-width: 768px) {
    :global(:root[data-scrolled='true']) .overlay {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 5rem;
  }

  /* ---------- logo ---------- */
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: #fff;
    transition: transform 400ms var(--ease);
  }

  .mark :global(img) {
    width: 34px;
    height: 34px;
  }

  .logo:hover .mark {
    transform: rotate(-12deg);
  }

  .word {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  /* ---------- nav ---------- */
  .nav {
    display: none;
    align-items: center;
    gap: 2rem;
    margin-inline: auto;
  }

  .nav-link {
    position: relative;
    padding: 0.4rem 0;
    font-size: 0.95rem;
    font-weight: 500;
    opacity: 0.85;
    transition: opacity 200ms var(--ease);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    opacity: 1;
  }

  /* A short lime bar grows under the link you point at, and stays on the current page. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--lime);
    transform: scaleX(0);
    transition: transform 260ms var(--ease);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* ---------- tools ---------- */
  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.8;
    transition:
      opacity 200ms var(--ease),
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .theme:hover {
    opacity: 1;
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
  }

  .theme > span {
    grid-area: 1 / 1;
    display: grid;
    transition:
      transform 360ms var(--ease),
      opacity 200ms var(--ease);
  }

  .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global(:root[data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  :global(:root[data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--lime);
    color: var(--on-lime);
  }

  .burger {
    display: grid;
    gap: 5px;
    width: 16px;
  }

  .burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 300ms var(--ease);
  }

  .menu-open .burger span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-open .burger span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (min-width: 1000px) {
    .nav {
      display: flex;
    }

    .tools {
      margin-left: 0;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 999px) {
    .cta {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.5rem 0 1.5rem;
    background: var(--bg);
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 380ms var(--ease);
  }

  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }

  .menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }

  .mobile-menu nav {
    display: grid;
  }

  .m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .m-cta {
    margin-top: 1.25rem;
  }
</style>

<script>
  const root = document.documentElement;

  // Solid bar once the page has moved: one attribute flip, not one per scroll event.
  let lifted: boolean | null = null;
  const onScroll = () => {
    const next = window.scrollY > 24;
    if (next !== lifted) {
      lifted = next;
      if (next) root.dataset.scrolled = 'true';
      else delete root.dataset.scrolled;
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme button. The choice is kept on this device only.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => themeBtn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('bsrf_theme', next);
    } catch {
      // Storage blocked: the switch still works for this visit.
    }
    sync();
  });

  // Mobile menu.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      if (open) menu.hidden = false;
      else
        window.setTimeout(() => {
          if (!open) menu.hidden = true;
        }, 380);
    };

    toggle.addEventListener('click', () => setOpen(!open));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }
</script>
