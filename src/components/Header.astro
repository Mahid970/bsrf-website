---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="lockup" href="/" aria-label={`${site.name}, home`}>
      <span class="mark">
        <Image src={mark} alt="" width={42} height={42} densities={[1, 2]} loading="eager" />
      </span>
      <span class="words">
        <span class="short">{site.short}</span>
        <span class="long">{site.name}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      {
        nav.map((item) => (
          <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button type="button" class="switch" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
        <span class="knob" aria-hidden="true">
          <span class="sun"><Icon name="sun" size={13} /></span>
          <span class="moon"><Icon name="moon" size={13} /></span>
        </span>
      </button>
      <a class="btn btn-primary btn-sm join" href="/#join">
        Join
        <span class="go"><Icon name="chevron" size={16} /></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      {
        nav.map((item) => (
          <a class="m-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a class="btn btn-primary m-join" href="/#join">
        Become a member
        <span class="go"><Icon name="chevron" size={16} /></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 260ms var(--ease),
      border-color 260ms var(--ease);
  }

  /* Transparent at the top; a solid bar with a hairline once the page moves. */
  :global(:root[data-scrolled='true']) .site-header,
  .site-header.menu-open {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom-color: var(--line);
  }

  @media (min-width: 768px) {
    :global(:root[data-scrolled='true']) .site-header {
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.5rem;
  }

  /* ---------- lockup ---------- */
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    transition: transform 400ms var(--ease);
  }

  .mark :global(img) {
    width: 42px;
    height: 42px;
  }

  :global(:root[data-theme='dark']) .mark {
    background: #fff;
  }

  :global(:root[data-theme='dark']) .mark :global(img) {
    width: 34px;
    height: 34px;
  }

  .lockup:hover .mark {
    transform: rotate(-10deg);
  }

  .words {
    display: grid;
    line-height: 1.1;
  }

  .short {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .long {
    font-size: 0.72rem;
    color: var(--muted);
  }

  /* ---------- nav ---------- */
  .nav {
    display: none;
    align-items: center;
    gap: 0.2rem;
    margin-inline: auto;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 550;
    color: var(--muted);
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--sunk);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  /* A small green dot marks the page you are on. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--green-bright);
    transform: scale(0);
    transition: transform 260ms var(--ease);
  }

  .nav-link[aria-current='page']::after {
    transform: scale(1);
  }

  /* ---------- tools ---------- */
  .tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  /* Theme switch: a knob slides across a track and swaps sun for moon. */
  .switch {
    position: relative;
    width: 3rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--sunk);
    border: 1px solid var(--line);
    transition: background-color 260ms var(--ease);
  }

  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    display: grid;
    place-items: center;
    width: calc(1.75rem - 6px);
    height: calc(1.75rem - 6px);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(18 20 58 / 0.25);
    transition: transform 320ms var(--ease);
  }

  .knob > span {
    grid-area: 1 / 1;
    display: grid;
    transition:
      opacity 200ms var(--ease),
      transform 320ms var(--ease);
  }

  .moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :global(:root[data-theme='dark']) .switch {
    background: var(--brand-wash);
  }

  :global(:root[data-theme='dark']) .knob {
    transform: translateX(1.25rem);
  }

  :global(:root[data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  :global(:root[data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }

  .switch:hover .knob {
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--brand) 18%, transparent),
      0 1px 3px rgb(18 20 58 / 0.25);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .burger {
    display: grid;
    gap: 4px;
    width: 16px;
  }

  .burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 300ms var(--ease),
      opacity 200ms var(--ease);
  }

  .menu-open .burger span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-open .burger span:nth-child(2) {
    opacity: 0;
  }

  .menu-open .burger span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (min-width: 960px) {
    .nav {
      display: flex;
    }

    .tools {
      margin-left: 0;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 959px) {
    .join {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .long {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding: 0.75rem 0 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 360ms var(--ease);
  }

  .mobile-menu[hidden] {
    display: block;
    visibility: hidden;
  }

  .menu-open .mobile-menu {
    clip-path: inset(0 0 0 0);
    visibility: visible;
  }

  .mobile-menu nav {
    display: grid;
  }

  .m-link {
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .m-join {
    margin-top: 1rem;
  }
</style>

<script>
  const root = document.documentElement;

  // Solid bar once the page has moved: one attribute flip, not one per scroll event.
  let lifted: boolean | null = null;
  const onScroll = () => {
    const next = window.scrollY > 8;
    if (next !== lifted) {
      lifted = next;
      if (next) root.dataset.scrolled = 'true';
      else delete root.dataset.scrolled;
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme switch. The choice is kept on this device only.
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncSwitch = () => themeBtn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  syncSwitch();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('bsrf_theme', next);
    } catch {
      // Storage blocked: the switch still works for this visit.
    }
    syncSwitch();
  });

  // Mobile menu.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu && label) {
    let open = false;
    const setOpen = (next: boolean) => {
      open = next;
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close menu' : 'Open menu';
      if (open) menu.hidden = false;
      else
        window.setTimeout(() => {
          if (!open) menu.hidden = true;
        }, 360);
    };

    toggle.addEventListener('click', () => setOpen(!open));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 960px)').addEventListener('change', (e) => {
      if (e.matches && open) setOpen(false);
    });
  }
</script>
