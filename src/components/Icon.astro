const paths = {
  research:
    '<path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 15v-3"/><path d="M12 15V9"/><path d="M16 15V7"/><path d="m7.5 9.5 4-3 4 2 4-4"/>',
