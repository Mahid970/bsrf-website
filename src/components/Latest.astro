---
import Icon from './Icon.astro';
import { publications } from '../data/site';
import { getEvents } from '../utils/events';
import { dateParts, isoDate } from '../utils/format';

const recent = publications.slice(0, 4);
const { upcoming } = await getEvents();
const soon = upcoming.slice(0, 3);
---

<section class="section latest" aria-label="Latest from the forum">
  <div class="container grid">
    <div class="col">
      <div class="col-head">
        <h2 data-reveal>Recent publications</h2>
        <a class="text-link" href="/publications/" data-reveal>All publications</a>
      </div>
      <ul class="pubs">
        {
          recent.map((p) => (
            <li data-reveal>
              <p class="meta">
                <span class="type">{p.type}</span>
                <span>{p.year}</span>
              </p>
              <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
              <p class="by">{p.authors}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col">
      <div class="col-head">
        <h2 data-reveal>Upcoming events</h2>
        <a class="text-link" href="/events/" data-reveal>All events</a>
      </div>
      {
        soon.length ? (
          <ul class="events">
            {soon.map((e) => {
              const d = dateParts(e.data.date);
              return (
                <li data-reveal>
                  <time class="date" datetime={isoDate(e.data.date)}>
                    <span class="date-month">{d.month}</span>
                    <span class="date-day">{d.day}</span>
                  </time>
                  <div class="event-text">
                    <p class="kind">{e.data.kind}</p>
                    <h3>
                      <a href={`/events/${e.id}/`}>{e.data.title}</a>
                    </h3>
                    {e.data.time && (
                      <p class="detail">
                        <Icon name="clock" size={15} />
                        {e.data.time}
                      </p>
                    )}
                    <p class="detail">
                      <Icon name="pin" size={15} />
                      {e.data.location}
                    </p>
                  </div>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty">
            No events are scheduled yet. Follow the forum on Facebook to hear about the next one first.
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }

  .col-head h2 {
    font-size: var(--step-3);
  }

  .col-head .text-link {
    font-size: 0.95rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  /* ---------- publications ---------- */
  .meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.4rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .type {
    font-weight: 600;
    color: var(--green);
  }

  .pubs h3 {
    font-size: var(--step-2);
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.3s var(--ease-out),
      color 0.2s ease;
  }

  h3 a:hover {
    color: var(--brand);
    background-size: 100% 1px;
  }

  .by {
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* ---------- events ---------- */
  .events li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .date {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    padding: 0.45rem 0 0.55rem;
    border-radius: var(--radius-s);
    background: var(--brand-tint);
    color: var(--brand);
    line-height: 1.1;
  }

  .date-month {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .date-day {
    font-family: var(--font-head);
    font-size: 1.7rem;
    font-weight: 600;
  }

  .event-text {
    display: grid;
    gap: 0.3rem;
  }

  .kind {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green);
  }

  .events h3 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin-bottom: 0.2rem;
  }

  .detail {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .detail :global(svg) {
    flex: none;
    margin-top: 0.12rem;
  }

  .empty {
    padding: 1.5rem 0;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
