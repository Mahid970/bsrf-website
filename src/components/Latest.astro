---
import Icon from './Icon.astro';
import { publications } from '../data/site';
import { getEvents } from '../utils/events';
import { dateParts, isoDate } from '../utils/format';

const recent = publications.slice(0, 4);
const { upcoming } = await getEvents();
const soon = upcoming.slice(0, 3);
---

<section class="band" aria-label="Latest from the forum">
  <div class="container section grid">
    <div class="col reveal">
      <div class="col-head">
        <h2 class="display">Recent publications</h2>
        <a class="link-grow" href="/publications/">All publications</a>
      </div>
      <ul class="rows">
        {
          recent.map((p) => {
            const inner = (
              <>
                <span class="pub-text">
                  <span class="meta">
                    <span class="tag">{p.type}</span>
                    <span class="muted">{p.area}</span>
                  </span>
                  <span class="pub-title">{p.title}</span>
                  <span class="muted by">{p.authors}</span>
                </span>
                <span class="score year">{p.year}</span>
              </>
            );
            return (
              <li>
                {p.url ? (
                  <a class="row-link pub" href={p.url}>
                    {inner}
                  </a>
                ) : (
                  <div class="panel pub">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="col reveal">
      <div class="col-head">
        <h2 class="display">Upcoming events</h2>
        <a class="link-grow" href="/events/">All events</a>
      </div>
      {
        soon.length ? (
          <ul class="rows">
            {soon.map((e) => {
              const d = dateParts(e.data.date);
              return (
                <li>
                  <a class="row-link event" href={`/events/${e.id}/`}>
                    <time class="date-tile" datetime={isoDate(e.data.date)}>
                      <span class="month">{d.month}</span>
                      <span class="day score">{d.day}</span>
                    </time>
                    <span class="event-text">
                      <span class="tag">{e.data.kind}</span>
                      <span class="event-title">{e.data.title}</span>
                      <span class="detail muted">
                        <Icon name="pin" size={14} />
                        {e.data.location}
                      </span>
                    </span>
                    <span class="row-arrow">
                      <Icon name="arrow" size={18} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="panel empty muted">No events are scheduled yet. Follow the forum on Facebook to hear about the next one first.</p>
        )
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 7fr 5fr;
      gap: 3rem;
    }
  }

  .col-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .col-head h2 {
    font-size: var(--text-2xl);
  }

  .col-head .link-grow {
    font-size: var(--text-sm);
  }

  .rows {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  /* ---------- publications ---------- */
  .pub {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
  }

  .pub-text {
    display: grid;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: var(--text-xs);
  }

  .pub-title {
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .by {
    font-size: var(--text-sm);
  }

  .year {
    font-size: 1.15rem;
    color: var(--ink-muted);
  }

  /* ---------- events ---------- */
  .event {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem 0.85rem 0.85rem;
  }

  .event-text {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }

  .event-title {
    font-weight: 600;
    line-height: 1.3;
  }

  .detail {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .detail :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }

  .empty {
    padding: 1.25rem;
  }
</style>
