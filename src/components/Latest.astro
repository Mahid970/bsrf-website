---
import EventCard from './EventCard.astro';
import { getEvents } from '../utils/events';

const { upcoming, past } = await getEvents();
// Upcoming first; if fewer than three are scheduled, fill with the latest past events.
const cards = [...upcoming, ...past].slice(0, 3);
---

<section class="container section" aria-labelledby="latest-title">
  <div class="section-head reveal">
    <div>
      <h2 id="latest-title">Seminars and workshops for every member</h2>
      <p>Sessions on research methods, reading circles and talks from faculty. Open to all members.</p>
    </div>
    <a class="btn btn-outline" href="/events/">See all events</a>
  </div>

  <ul class="grid">
    {
      cards.map((e) => (
        <li class="reveal">
          <EventCard entry={e} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    gap: 2rem 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
