---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <h2>
        <a href="/#join">Want to research with us?</a>
      </h2>
      <ul class="social">
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
        {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
        <li><a href={site.mapUrl} target="_blank" rel="noopener">Find us</a></li>
      </ul>
    </div>

    <div class="middle">
      <p class="address">{`${site.department}, ${site.faculty}, ${site.university}`}</p>

      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <span class="mark">
          <Image src={mark} alt="" width={44} height={44} densities={[1, 2]} />
        </span>
        <span class="word">{site.short}</span>
      </a>

      <nav class="links" aria-label="Footer">
        {
          nav.map((item, i) => (
            <>
              {i > 0 && <span aria-hidden="true">-</span>}
              <a href={item.href}>{item.label}</a>
            </>
          ))
        }
      </nav>
    </div>

    <p class="copy">{`© ${year} ${site.name}. ${site.tagline}`}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer);
    color: var(--on-footer-muted);
    font-size: 0.9rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  h2 {
    max-width: 13ch;
    color: var(--lime);
    font-size: clamp(2.4rem, 1.6rem + 3vw, 3.75rem);
    line-height: 1.1;
  }

  h2 a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 3px no-repeat;
    transition: background-size 500ms var(--ease);
  }

  h2 a:hover {
    background-size: 100% 3px;
  }

  .social {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    text-align: right;
  }

  .social a {
    color: var(--on-footer);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      color 200ms var(--ease),
      text-decoration-color 200ms var(--ease);
  }

  .social a:hover {
    color: var(--lime);
  }

  .middle {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--footer-line);
  }

  @media (min-width: 900px) {
    .middle {
      grid-template-columns: 1fr auto 1fr;
    }

    .links {
      justify-content: flex-end;
    }
  }

  .address {
    max-width: 22rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: center;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: #fff;
  }

  .mark :global(img) {
    width: 40px;
    height: 40px;
  }

  .word {
    color: #fff;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
  }

  .links a {
    transition: color 200ms var(--ease);
  }

  .links a:hover {
    color: var(--lime);
  }

  .copy {
    padding-block: 1.5rem 2rem;
    text-align: center;
    font-size: 0.85rem;
  }

  .footer :global(:focus-visible) {
    outline-color: var(--lime);
  }

  @media (max-width: 899px) {
    .social {
      text-align: left;
    }

    .brand {
      justify-self: start;
    }
  }
</style>
