---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container cols">
    <div class="brand">
      <a class="lockup" href="/">
        <span class="mark">
          <Image src={mark} alt="" width={56} height={56} densities={[1, 2]} />
        </span>
        <span class="wordmark">
          <span>BankSure Scientific</span>
          <span>Research Forum</span>
        </span>
      </a>
      <p class="muted">{`A research platform of faculty members and students of the ${site.department}, ${site.university}.`}</p>
    </div>

    <div class="col">
      <h2>Explore</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a class="link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="link" href="/#join">Become a member</a></li>
      </ul>
    </div>

    <div class="col">
      <h2>Visit</h2>
      <address class="muted">
        {site.department}
        <br />
        {site.faculty}
        <br />
        {site.university}
        <br />
        {site.city}
      </address>
      <a class="link" href={site.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
    </div>

    <div class="col">
      <h2>Connect</h2>
      <ul>
        <li>
          <a class="link with-icon" href={site.facebook} target="_blank" rel="noopener">
            <Icon name="facebook" size={16} />
            Facebook
          </a>
        </li>
        {
          site.email && (
            <li>
              <a class="link with-icon" href={`mailto:${site.email}`}>
                <Icon name="mail" size={16} />
                {site.email}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="container base">
    <p>{`© ${year} ${site.name}. All rights reserved.`}</p>
    <p>{site.tagline}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--hairline);
    font-size: var(--text-sm);
  }

  .cols {
    display: grid;
    gap: 2.5rem 2rem;
    padding-block: 3rem;
  }

  @media (min-width: 640px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    }

    .brand {
      grid-column: auto;
    }
  }

  .brand {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: 26rem;
  }

  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
  }

  .mark :global(img) {
    width: 56px;
    height: 56px;
  }

  :global(:root[data-theme='dark']) .mark {
    background: #fff;
  }

  :global(:root[data-theme='dark']) .mark :global(img) {
    width: 46px;
    height: 46px;
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.35rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  h2 {
    margin-bottom: 0.9rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .col {
    display: grid;
    align-content: start;
  }

  ul {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
  }

  address {
    font-style: normal;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .link {
    color: var(--ink-muted);
    transition: color 160ms var(--ease);
  }

  .link:hover {
    color: var(--ink);
  }

  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid var(--hairline);
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }
</style>
