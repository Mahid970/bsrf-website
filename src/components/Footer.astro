---
import { Image } from 'astro:assets';
import mark from '../assets/brand/bsrf-mark.png';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="cols">
      <div class="brand">
        <a class="lockup" href="/">
          <span class="mark-wrap">
            <Image src={mark} alt="" width={44} height={44} densities={[1, 2]} />
          </span>
          <span class="lockup-text">
            <span class="lockup-name">{site.name}</span>
            <span class="lockup-sub">{site.university}</span>
          </span>
        </a>
        <p>{`A research platform of faculty members and students of the ${site.department}.`}</p>
      </div>

      <div class="col">
        <h2>Visit</h2>
        <address>
          {site.department}
          <br />
          {site.faculty}
          <br />
          {site.university}
          <br />
          {site.city}
        </address>
        <a href={site.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
      </div>

      <div class="col">
        <h2>Explore</h2>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col">
        <h2>Connect</h2>
        <ul>
          <li>
            <a class="with-icon" href={site.facebook} target="_blank" rel="noopener">
              <Icon name="facebook" size={18} />
              Facebook
            </a>
          </li>
          {
            site.email && (
              <li>
                <a class="with-icon" href={`mailto:${site.email}`}>
                  <Icon name="mail" size={18} />
                  {site.email}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="base">
      <p>{`© ${year} ${site.name}`}</p>
      <p>{site.tagline}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: var(--on-navy-muted);
    font-size: 0.95rem;
    border-top: 1px solid var(--navy-line);
  }

  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .brand {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 22rem;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .mark-wrap {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-s);
    background: #fff;
  }

  .mark-wrap :global(img) {
    width: 44px;
    height: 44px;
  }

  .lockup-text {
    display: grid;
    line-height: 1.25;
  }

  .lockup-name {
    font-family: var(--font-head);
    font-weight: 600;
    color: #fff;
  }

  .lockup-sub {
    font-size: 0.8125rem;
  }

  h2 {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    color: #fff;
    margin-bottom: 1rem;
  }

  .col {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  address {
    font-style: normal;
    line-height: 1.6;
  }

  ul {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  a {
    color: var(--on-navy);
    text-decoration: none;
  }

  a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .lockup:hover {
    text-decoration: none;
  }

  .with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--navy-line);
    font-size: 0.85rem;
  }

  .footer :global(:focus-visible) {
    outline-color: #fff;
  }

  @media (max-width: 980px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
