---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { getLaunchPhotos } from '../data/photos';

const photos = await getLaunchPhotos();
const bg = photos[13]; // faculty and students together around the table

// Every launch photo, ready for the viewer opened by the round button.
const viewer = await Promise.all(
  photos.map(async (p) => ({ ...p, full: (await getImage({ src: p.src, width: 1800, format: 'webp' })).src })),
);
---

<section class="banner" aria-labelledby="banner-title">
  <Image class="bg" src={bg.src} alt="" widths={[768, 1080, 1440, 1920]} sizes="100vw" />
  <div class="shade" aria-hidden="true"></div>

  <div class="container inner reveal">
    <div>
      <h2 id="banner-title">Be part of the next generation of finance researchers</h2>
      <div class="actions">
        <a class="btn btn-lime" href="#join">Become a member</a>
        <a class="btn btn-outline-light" href="/events/forum-launch/">Read about the launch</a>
      </div>
    </div>

    <button
      type="button"
      class="play"
      data-lightbox="launch-all"
      data-src={viewer[0].full}
      data-alt={viewer[0].alt}
      data-caption={viewer[0].caption ?? ''}
    >
      <Icon name="camera" size={26} />
      <span class="visually-hidden">{`View all ${viewer.length} launch photos`}</span>
    </button>
    {
      viewer.slice(1).map((p) => (
        <button type="button" hidden data-lightbox="launch-all" data-src={p.full} data-alt={p.alt} data-caption={p.caption ?? ''} tabindex="-1" />
      ))
    }
  </div>
</section>

<style>
  .banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(24rem, 40vw, 32rem);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    background: #1c2416;
  }

  .banner :global(.bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(10 14 8 / 0.15), rgb(10 14 8 / 0.72));
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  h2 {
    max-width: 18ch;
    color: #fff;
    font-size: var(--h2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* Big lime circle that opens the photo viewer; it pulses gently on hover. */
  .play {
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: var(--lime);
    color: var(--on-lime);
    transition: transform 320ms var(--ease);
  }

  .play:hover {
    transform: scale(1.08);
    animation: ring 1.4s var(--ease) infinite;
  }

  @keyframes ring {
    0% {
      box-shadow: 0 0 0 0 rgb(218 245 106 / 0.6);
    }
    100% {
      box-shadow: 0 0 0 18px rgb(218 245 106 / 0);
    }
  }

  .banner :global(:focus-visible) {
    outline-color: #fff;
  }
</style>
