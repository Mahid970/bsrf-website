---
import { Image, getImage } from 'astro:assets';
import { site } from '../data/site';
import { launchPhotos, reelPhotos } from '../data/photos';

const frames = await Promise.all(
  reelPhotos.map(async (p) => {
    const full = await getImage({ src: p.src, width: 1800, format: 'webp' });
    return { ...p, full: full.src, portrait: p.src.height > p.src.width };
  }),
);
---

<section class="launch" id="launch" aria-labelledby="launch-title" data-reel>
  <div class="pin" data-reel-pin>
    <div class="intro container">
      <h2 id="launch-title" data-reveal="words">{`${site.foundedLabel}: the forum opens`}</h2>
      <p data-reveal="fade">
        Students and faculty filled {site.firstVenue} for the launch: talks from faculty members, a session on higher study, the first member badges and a cake with the forum’s logo.
      </p>
    </div>

    <div class="viewport" data-reel-viewport>
      <ul class="track" data-reel-track>
        {
          frames.map((f, i) => (
            <li class:list={['frame', { portrait: f.portrait }]} data-reel-frame>
              <button
                type="button"
                class="open"
                data-lightbox="launch-reel"
                data-src={f.full}
                data-caption={f.caption}
                data-alt={f.alt}
                aria-label={`Open photo: ${f.caption}`}
              >
                <span class="img-wrap">
                  <Image
                    src={f.src}
                    alt={f.alt}
                    widths={[480, 768, 1080]}
                    sizes={f.portrait ? '(min-width: 881px) 36vh, 70vw' : '(min-width: 881px) 85vh, 85vw'}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    class="img"
                    data-reel-img
                  />
                </span>
              </button>
              <p class="caption">{f.caption}</p>
            </li>
          ))
        }
        <li class="frame end">
          <a class="end-card" href="/events/forum-launch/">
            <span class="end-count">{launchPhotos.length} photos</span>
            <span class="end-title">Read about the launch and see every photo</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="progress container" aria-hidden="true">
      <span class="progress-bar"><span class="progress-fill" data-reel-progress></span></span>
    </div>
  </div>
</section>

<style>
  .launch {
    padding-top: var(--section);
  }

  .pin {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    min-height: 100svh;
    padding-block: 5.5rem 2rem;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 4rem;
    align-items: end;
  }

  .intro h2 {
    font-size: var(--step-4);
    max-width: 14ch;
  }

  .intro p {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 32rem;
  }

  .viewport {
    overflow: hidden;
  }

  .track {
    --reel-h: clamp(16rem, 52vh, 34rem);
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    width: max-content;
    list-style: none;
    padding: 0 var(--gutter);
    padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2));
    will-change: transform;
  }

  .frame {
    flex: none;
    display: grid;
    gap: 0.75rem;
    width: calc(var(--reel-h) * 1.333);
  }

  .frame.portrait {
    width: calc(var(--reel-h) * 0.75);
  }

  .open {
    display: block;
    width: 100%;
    height: var(--reel-h);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--blue-tint);
    cursor: zoom-in;
  }

  .img-wrap {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: filter 0.5s ease;
  }

  .open:hover :global(img) {
    filter: saturate(1.15) contrast(1.03);
  }

  .caption {
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .end {
    width: calc(var(--reel-h) * 0.85);
  }

  .end-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--reel-h);
    padding: 1.75rem;
    border-radius: var(--radius-m);
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      transform 0.6s var(--ease-out);
  }

  .end-card:hover {
    background: var(--blue-deep);
    transform: translateY(-6px);
  }

  .end-count {
    font-family: var(--font-ui);
    font-weight: 600;
    color: #c9c6ff;
  }

  .end-title {
    font-family: var(--font-ui);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .progress-bar {
    display: block;
    height: 2px;
    background: var(--line);
  }

  .progress-fill {
    display: block;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Phones and tablets: a swipeable carousel instead of the pinned reel. */
  @media (max-width: 880px) {
    .pin {
      min-height: 0;
      padding-block: 0;
    }

    .intro {
      grid-template-columns: 1fr;
    }

    .viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    .viewport::-webkit-scrollbar {
      display: none;
    }

    .track {
      --reel-h: clamp(15rem, 62vw, 24rem);
    }

    .frame {
      scroll-snap-align: start;
      scroll-margin-left: var(--gutter);
      max-width: 85vw;
    }

    .img-wrap :global(img) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
    }

    .img-wrap :global(img) {
      transform: none;
    }
  }
</style>

<script>
  import { gsap, reduceMotion } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-reel]');
  const pin = document.querySelector<HTMLElement>('[data-reel-pin]');
  const track = document.querySelector<HTMLElement>('[data-reel-track]');
  const viewport = document.querySelector<HTMLElement>('[data-reel-viewport]');
  const progress = document.querySelector<HTMLElement>('[data-reel-progress]');

  if (section && pin && track && viewport && progress) {
    const mm = gsap.matchMedia();

    if (!reduceMotion) {
      mm.add('(min-width: 881px)', () => {
        const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);

        const tween = gsap.to(track, {
          x: () => -distance(),
          ease: 'none',
          scrollTrigger: {
            trigger: pin,
            start: 'top top',
            end: () => `+=${distance()}`,
            pin: true,
            scrub: 0.8,
            invalidateOnRefresh: true,
            onUpdate: (self) => gsap.set(progress, { scaleX: self.progress }),
          },
        });

        // Photos drift inside their frames as they cross the screen.
        gsap.utils.toArray<HTMLElement>('[data-reel-img]').forEach((img) => {
          gsap.fromTo(
            img,
            { xPercent: -5 },
            {
              xPercent: 5,
              ease: 'none',
              scrollTrigger: {
                trigger: img.closest('[data-reel-frame]'),
                containerAnimation: tween,
                start: 'left right',
                end: 'right left',
                scrub: true,
              },
            },
          );
        });
      });
    }

    // Carousel progress on small screens (and with reduced motion).
    viewport.addEventListener(
      'scroll',
      () => {
        const max = viewport.scrollWidth - viewport.clientWidth;
        if (max > 0) progress.style.transform = `scaleX(${viewport.scrollLeft / max})`;
      },
      { passive: true },
    );
  }
</script>
