---
import { Image, getImage } from 'astro:assets';
import { site } from '../data/site';
import { getLaunchPhotos, homePicks } from '../data/photos';

const all = await getLaunchPhotos();
const picks = await Promise.all(
  homePicks.gallery.map(async (i) => {
    const p = all[i];
    const full = await getImage({ src: p.src, width: 1800, format: 'webp' });
    return { ...p, full: full.src };
  }),
);
---

<section class="band" id="gallery" aria-labelledby="gallery-title">
  <div class="container section">
    <div class="section-head reveal">
      <div>
        <h2 id="gallery-title" class="display">From the launch</h2>
        <p>{`${site.foundedLabel}, ${site.firstVenue}, ${site.department}.`}</p>
      </div>
      <a class="link-grow" href="/events/forum-launch/">{`See all ${all.length} photos`}</a>
    </div>

    <ul class="grid reveal">
      {
        picks.map((p, i) => (
          <li class:list={[{ big: i === 0 }]}>
            <button
              type="button"
              class="open"
              data-lightbox="home-gallery"
              data-src={p.full}
              data-alt={p.alt}
              data-caption={p.caption ?? ''}
              aria-label={`Open photo: ${p.caption ?? p.alt}`}
            >
              <Image
                src={p.src}
                alt={p.alt}
                widths={i === 0 ? [640, 960, 1280] : [400, 640]}
                sizes={i === 0 ? '(min-width: 1024px) 50vw, 92vw' : '(min-width: 1024px) 25vw, 46vw'}
              />
              {p.caption && <span class="caption">{p.caption}</span>}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(10rem, 16vw, 14rem);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .big {
    grid-column: span 2;
    grid-row: span 2;
  }

  li {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--surface-sunk);
    transition:
      border-color 200ms var(--ease),
      box-shadow 260ms var(--ease),
      translate 260ms var(--ease);
  }

  li:hover {
    border-color: var(--brand);
    box-shadow: 4px 4px 0 var(--brand);
    translate: -2px -2px;
  }

  .open {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  .open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .open:hover :global(img) {
    transform: scale(1.04);
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-align: left;
    color: #fff;
    background: linear-gradient(to top, rgb(12 13 19 / 0.75), transparent);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
  }

  .open:hover .caption,
  .open:focus-visible .caption {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 9rem;
    }
  }

  @media (hover: none) {
    .caption {
      display: none;
    }
  }
</style>
