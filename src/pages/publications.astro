---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { publications, researchAreas, site } from '../data/site';

const sorted = [...publications].sort((a, b) => b.year - a.year);
const types = [...new Set(publications.map((p) => p.type))];
---

<Base title="Publications" description={`Working papers, conference papers and policy briefs by members of ${site.name}.`}>
  <PageHeader
    title="Publications"
    lead="Working papers, conference papers and policy briefs written by forum members with their faculty advisors."
  />

  <div class="container layout">
    <div class="main">
      <div class="filters panel" role="group" aria-label="Filter by type" data-types>
        <button type="button" class="segment" aria-pressed="true" data-type-filter="all">All</button>
        {
          types.map((t) => (
            <button type="button" class="segment" aria-pressed="false" data-type-filter={t}>
              {t}
            </button>
          ))
        }
      </div>

      <p class="status muted" aria-live="polite" data-status>
        <span data-count>{sorted.length}</span> <span data-noun>publications</span>
        <span class="area-note" data-area-note hidden>
          {' '}in <strong data-area-name></strong>{' '}
          <a class="link-grow" href="/publications/" data-clear>Show all areas</a>
        </span>
      </p>

      <ul class="rows">
        {
          sorted.map((p) => (
            <li data-type={p.type} data-area={p.area}>
              <div class="panel pub">
                <span class="pub-text">
                  <span class="meta">
                    <span class="tag">{p.type}</span>
                    <span class="muted">{p.area}</span>
                  </span>
                  <span class="pub-title">{p.url ? <a class="link-grow plain" href={p.url}>{p.title}</a> : p.title}</span>
                  <span class="muted by">{p.authors}</span>
                </span>
                <span class="score year">{p.year}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="panel empty muted" data-empty hidden>No publications match this filter yet.</p>
    </div>

    <aside class="side">
      <div class="panel card">
        <h2>Research areas</h2>
        <ul class="areas">
          {
            researchAreas.map((a) => (
              <li>
                <a class="area-link" href={`/publications/?area=${encodeURIComponent(a.title)}`} data-area-link={a.title}>
                  <Icon name={a.icon} size={16} />
                  {a.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel card">
        <h2>Publish with the forum</h2>
        <p class="muted">Members can submit work for review by a faculty advisor before it is listed here.</p>
        <a class="link-grow" href="/#join">How membership works</a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 2rem;
    align-items: start;
    padding-bottom: var(--section);
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 2.5rem;
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.35rem;
    border-radius: var(--radius);
  }

  .status {
    margin: 1rem 0 0.75rem;
    font-size: var(--text-sm);
  }

  .status strong {
    color: var(--ink);
  }

  .rows {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  .rows li[hidden] {
    display: none;
  }

  .pub {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
  }

  .pub-text {
    display: grid;
    gap: 0.35rem;
    flex: 1;
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    font-size: var(--text-xs);
  }

  .pub-title {
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .plain {
    color: inherit;
  }

  .by {
    font-size: var(--text-sm);
  }

  .year {
    font-size: 1.15rem;
    color: var(--ink-muted);
  }

  .empty {
    padding: 1.25rem;
  }

  /* ---------- sidebar ---------- */
  .side {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 960px) {
    .side {
      position: sticky;
      top: 6.5rem;
    }
  }

  .card {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    font-size: 0.95rem;
  }

  .card h2 {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .areas {
    display: grid;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
  }

  .area-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 8px;
    color: var(--ink-muted);
    font-weight: 500;
    line-height: 1.3;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }

  .area-link :global(svg) {
    flex: none;
    color: var(--brand);
  }

  .area-link:hover,
  .area-link[aria-current='true'] {
    background: var(--brand-wash);
    color: var(--ink);
  }
</style>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-type]')];
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type-filter]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const areaNote = document.querySelector<HTMLElement>('[data-area-note]');
  const areaName = document.querySelector<HTMLElement>('[data-area-name]');

  const area = new URLSearchParams(location.search).get('area');
  let type = 'all';

  const apply = () => {
    let shown = 0;
    items.forEach((li) => {
      const ok = (type === 'all' || li.dataset.type === type) && (!area || li.dataset.area === area);
      li.hidden = !ok;
      if (ok) shown += 1;
    });
    if (count) count.textContent = String(shown);
    const noun = document.querySelector<HTMLElement>('[data-noun]');
    if (noun) noun.textContent = shown === 1 ? 'publication' : 'publications';
    if (empty) empty.hidden = shown > 0;
  };

  if (area && areaNote && areaName) {
    areaName.textContent = area;
    areaNote.hidden = false;
    document.querySelectorAll<HTMLElement>('[data-area-link]').forEach((a) => {
      if (a.dataset.areaLink === area) a.setAttribute('aria-current', 'true');
    });
  }

  typeButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      type = btn.dataset.typeFilter ?? 'all';
      typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply();
    }),
  );

  apply();
</script>
