---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="nf container">
    <p class="code">Error 404</p>
    <h1>We couldn’t find that page</h1>
    <p class="lead">The link may be out of date or mistyped. Try one of these instead.</p>
    <ul class="links">
      <li><a class="btn btn-primary" href="/">Go to the home page</a></li>
      <li><a class="btn btn-secondary" href="/events/">See events</a></li>
      <li><a class="btn btn-secondary" href="/publications/">Browse publications</a></li>
    </ul>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
  }

  .code {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green);
  }

  h1 {
    font-size: var(--step-5);
    max-width: 18ch;
  }

  .lead {
    font-size: var(--step-1);
    max-width: 36rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
  }
</style>
