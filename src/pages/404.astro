---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="nf container">
    <span class="chip">Error 404</span>
    <h1>We couldn’t find that page</h1>
    <p class="lead muted">The link may be out of date or mistyped. Try one of these instead.</p>
    <ul class="links">
      <li><a class="btn btn-primary" href="/">Go to the home page</a></li>
      <li><a class="btn btn-ghost" href="/events/">See events</a></li>
      <li><a class="btn btn-ghost" href="/publications/">Browse publications</a></li>
    </ul>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
  }


  h1 {
    font-weight: 800;
    letter-spacing: -0.035em;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.5rem);
    max-width: 18ch;
  }

  .lead {
    font-size: 1.15rem;
    max-width: 36rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
  }
</style>
