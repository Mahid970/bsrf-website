---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import { site } from '../../data/site';
import { getEvents } from '../../utils/events';

const { upcoming, past } = await getEvents();
---

<Base title="Events" description={`Seminars, workshops and reading circles from ${site.name}.`}>
  <PageHeader
    title="Events"
    lead="Seminars, workshops and reading circles for members and anyone interested in research on banking, insurance and finance."
  />

  <div class="container body">
    <section aria-labelledby="upcoming-title">
      <h2 id="upcoming-title">Upcoming</h2>
      {
        upcoming.length ? (
          <ul class="grid">
            {upcoming.map((e) => (
              <li class="reveal">
                <EventCard entry={e} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="panel empty">
            No events are scheduled yet.{' '}
            <a class="link" href={site.facebook} target="_blank" rel="noopener">
              Follow us on Facebook
            </a>{' '}
            to hear about the next one.
          </p>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section aria-labelledby="past-title">
          <h2 id="past-title">Past events</h2>
          <ul class="grid">
            {past.map((e) => (
              <li class="reveal">
                <EventCard entry={e} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .body {
    display: grid;
    gap: clamp(3.5rem, 3rem + 3vw, 5rem);
    padding-bottom: var(--section);
  }

  h2 {
    margin-bottom: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.6rem;
  }

  .grid {
    display: grid;
    gap: 2.5rem 1.5rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .empty {
    padding: 1.5rem;
  }
</style>
