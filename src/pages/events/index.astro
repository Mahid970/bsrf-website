---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { getEvents } from '../../utils/events';
import { dateParts, formatDate, isoDate } from '../../utils/format';

const { upcoming, past } = await getEvents();
---

<Base title="Events" description={`Seminars, workshops and reading circles from ${site.name}.`}>
  <PageHeader
    title="Events"
    lead="Seminars, workshops and reading circles for members and anyone interested in research on banking, insurance and finance."
  />

  <div class="container body">
    <section aria-labelledby="upcoming-title">
      <h2 id="upcoming-title">Upcoming</h2>
      {
        upcoming.length ? (
          <ul class="card list reveal">
            {upcoming.map((e) => {
              const d = dateParts(e.data.date);
              return (
                <li>
                  <a class="item" href={`/events/${e.id}/`}>
                    <time class="cal" datetime={isoDate(e.data.date)}>
                      <span class="m">{d.month}</span>
                      <span class="d">{d.day}</span>
                    </time>
                    <span class="text">
                      <span class="chip">{e.data.kind}</span>
                      <span class="title">{e.data.title}</span>
                      <span class="summary muted">{e.data.summary}</span>
                      <span class="meta muted">
                        {e.data.time && (
                          <span>
                            <Icon name="clock" size={15} />
                            {e.data.time}
                          </span>
                        )}
                        <span>
                          <Icon name="pin" size={15} />
                          {e.data.location}
                        </span>
                      </span>
                    </span>
                    <span class="go" aria-hidden="true">
                      <Icon name="chevron" size={18} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="card empty muted">
            No events are scheduled yet.{' '}
            <a class="link" href={site.facebook} target="_blank" rel="noopener">
              Follow us on Facebook
            </a>{' '}
            to hear about the next one.
          </p>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section aria-labelledby="past-title">
          <h2 id="past-title">Past events</h2>
          <ul class="past">
            {past.map((e) => (
              <li class="reveal">
                <a class="card-link past-card" href={`/events/${e.id}/`}>
                  <span class="thumb" style={`view-transition-name: cover-${e.id}`}>
                    {e.data.cover ? (
                      <Image src={e.data.cover} alt="" widths={[400, 640, 800]} sizes="(min-width: 900px) 380px, 92vw" />
                    ) : (
                      <span class="thumb-empty">
                        <Icon name="calendar" size={32} />
                      </span>
                    )}
                  </span>
                  <span class="past-text">
                    <span class="chip chip-neutral">{e.data.kind}</span>
                    <span class="title">{e.data.title}</span>
                    <span class="muted when">{formatDate(e.data.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .body {
    display: grid;
    gap: 3.5rem;
    padding-bottom: var(--section);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: var(--text-xl);
  }

  .list {
    overflow: hidden;
    list-style: none;
    padding: 0;
  }

  .list li + li {
    border-top: 1px solid var(--line);
  }

  .item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.4rem clamp(1rem, 0.5rem + 2vw, 1.75rem);
    transition: background-color 220ms var(--ease);
  }

  .item:hover {
    background: color-mix(in srgb, var(--brand-wash) 60%, transparent);
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .summary {
    max-width: 50rem;
    font-size: 0.975rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    font-size: var(--text-sm);
  }

  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .go {
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.4rem;
    height: 2.4rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--muted);
    transition:
      background-color 220ms var(--ease),
      border-color 220ms var(--ease),
      color 220ms var(--ease),
      transform 260ms var(--ease);
  }

  .item:hover .go {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    transform: translateX(3px);
  }

  .empty {
    padding: 1.5rem;
  }

  /* ---------- past ---------- */
  .past {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }

  .past-card {
    display: grid;
    height: 100%;
    overflow: hidden;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--sunk);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .past-card:hover .thumb :global(img) {
    transform: scale(1.04);
  }

  .thumb-empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--brand);
    opacity: 0.5;
  }

  .past-text {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .when {
    font-size: var(--text-sm);
  }

  @media (max-width: 560px) {
    .item {
      gap: 0.9rem;
    }

    .go {
      display: none;
    }
  }
</style>
