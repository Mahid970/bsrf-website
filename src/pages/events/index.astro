---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { formatDate } from '../../utils/format';

const events = (await getCollection('events')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Events" description={`Sessions, workshops and news from ${site.name}.`}>
  <section class="events container">
    <header class="head">
      <h1 data-reveal="words">Events and news</h1>
      <p data-reveal="fade">
        Sessions, workshops and news from the forum. New events are also posted on our{' '}
        <a href={site.facebook} target="_blank" rel="noopener">Facebook page</a>.
      </p>
    </header>

    <ol class="list">
      {
        events.map((e) => (
          <li data-reveal="fade">
            <a class="item" href={`/events/${e.id}/`}>
              <time class="date" datetime={e.data.date.toISOString().slice(0, 10)}>
                {formatDate(e.data.date)}
              </time>
              <span class="text">
                <span class="title">{e.data.title}</span>
                <span class="summary">{e.data.summary}</span>
                <span class="where">{e.data.location}</span>
              </span>
              <span class="thumb" style={`view-transition-name: cover-${e.id}`}>
                <Image src={e.data.cover} alt="" widths={[480, 800]} sizes="(min-width: 881px) 26rem, 92vw" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .events {
    padding-top: 8rem;
    padding-bottom: var(--section);
  }

  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }

  h1 {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
  }

  .head p {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .head a {
    color: var(--blue);
  }

  .list {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--ink);
  }

  .item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 26rem;
    gap: 1.5rem 3rem;
    align-items: center;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .date {
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--green-ink);
    align-self: start;
    padding-top: 0.4rem;
  }

  .text {
    display: grid;
    gap: 0.75rem;
  }

  .title {
    font-family: var(--font-ui);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    transition: color 0.3s ease;
  }

  .item:hover .title {
    color: var(--blue);
  }

  .summary {
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .where {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--blue-tint);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }

  .item:hover .thumb :global(img) {
    transform: scale(1.05);
  }

  @media (max-width: 1080px) {
    .item {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }

    .date {
      grid-column: 1 / -1;
      padding: 0;
    }
  }

  @media (max-width: 720px) {
    .events {
      padding-top: 6.5rem;
    }

    .item {
      grid-template-columns: 1fr;
    }

    .thumb {
      order: -1;
    }
  }
</style>
