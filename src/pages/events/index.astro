---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { getEvents } from '../../utils/events';
import { dateParts, formatDate, isoDate } from '../../utils/format';

const { upcoming, past } = await getEvents();
---

<Base title="Events" description={`Seminars, workshops and reading circles from ${site.name}.`}>
  <PageHeader
    title="Events"
    lead="Seminars, workshops and reading circles for members and anyone interested in research on banking, insurance and finance."
  />

  <div class="container body">
    <section aria-labelledby="upcoming-title">
      <h2 id="upcoming-title" class="display list-title">
        Upcoming
        <span class="score count">{upcoming.length}</span>
      </h2>
      {
        upcoming.length ? (
          <ul class="rows">
            {upcoming.map((e) => {
              const d = dateParts(e.data.date);
              return (
                <li class="reveal">
                  <a class="row-link row" href={`/events/${e.id}/`}>
                    <time class="date-tile big" datetime={isoDate(e.data.date)}>
                      <span class="month">{d.month}</span>
                      <span class="day score">{d.day}</span>
                    </time>
                    <span class="text">
                      <span class="tag">{e.data.kind}</span>
                      <span class="title">{e.data.title}</span>
                      <span class="summary muted">{e.data.summary}</span>
                      <span class="details muted">
                        {e.data.time && (
                          <span>
                            <Icon name="clock" size={15} />
                            {e.data.time}
                          </span>
                        )}
                        <span>
                          <Icon name="pin" size={15} />
                          {e.data.location}
                        </span>
                      </span>
                    </span>
                    <span class="row-arrow">
                      <Icon name="arrow" size={20} />
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="panel empty muted">
            No events are scheduled yet.{' '}
            <a class="link-grow" href={site.facebook} target="_blank" rel="noopener">
              Follow us on Facebook
            </a>{' '}
            to hear about the next one.
          </p>
        )
      }
    </section>

    {
      past.length > 0 && (
        <section aria-labelledby="past-title">
          <h2 id="past-title" class="display list-title">
            Past events
            <span class="score count">{past.length}</span>
          </h2>
          <ul class="past">
            {past.map((e) => (
              <li class="reveal">
                <a class="row-link past-card" href={`/events/${e.id}/`}>
                  <span class="thumb" style={`view-transition-name: cover-${e.id}`}>
                    {e.data.cover ? (
                      <Image src={e.data.cover} alt="" widths={[400, 640, 800]} sizes="(min-width: 900px) 360px, 92vw" />
                    ) : (
                      <span class="thumb-empty">
                        <Icon name="calendar" size={32} />
                      </span>
                    )}
                  </span>
                  <span class="past-text">
                    <span class="tag">{e.data.kind}</span>
                    <span class="title">{e.data.title}</span>
                    <span class="muted date">{formatDate(e.data.date)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .body {
    display: grid;
    gap: 3.5rem;
    padding-bottom: var(--section);
  }

  .list-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
    font-size: var(--text-2xl);
  }

  .count {
    font-size: 1.1rem;
    color: var(--brand);
  }

  .rows {
    display: grid;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.1rem 1.25rem 1.1rem 1.1rem;
  }

  .date-tile.big {
    width: 4.25rem;
  }

  .date-tile.big .day {
    font-size: 2rem;
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 106%;
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .summary {
    max-width: 52rem;
    font-size: 0.95rem;
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-size: var(--text-sm);
  }

  .details span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .row .row-arrow {
    align-self: center;
  }

  .empty {
    padding: 1.25rem;
  }

  /* ---------- past ---------- */
  .past {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .past-card {
    display: grid;
    height: 100%;
    overflow: hidden;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--surface-sunk);
    overflow: hidden;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .past-card:hover .thumb :global(img) {
    transform: scale(1.04);
  }

  .thumb-empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--brand);
    opacity: 0.5;
  }

  .past-text {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.1rem;
  }

  .date {
    font-size: var(--text-sm);
  }

  @media (max-width: 560px) {
    .row {
      gap: 0.85rem;
      padding: 0.9rem;
    }

    .date-tile.big {
      width: 3.5rem;
    }

    .date-tile.big .day {
      font-size: 1.6rem;
    }

    .row .row-arrow {
      display: none;
    }
  }
</style>
