---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { formatDate, isoDate } from '../../utils/format';

export const getStaticPaths = (async () => {
  const events = await getCollection('events');
  return events.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, kind, date, time, location, summary, cover, coverAlt, gallery } = entry.data;

const photos = await Promise.all(
  gallery.map(async (p) => ({
    ...p,
    full: (await getImage({ src: p.src, width: 1800, format: 'webp' })).src,
  })),
);
---

<Base title={title} description={summary}>
  <PageHeader title={title} lead={summary} kind={kind} back={{ href: '/events/', label: 'All events' }} />

  <div class="container layout">
    <article class="main">
      {
        cover && (
          <div class="cover" style={`view-transition-name: cover-${entry.id}`}>
            <Image src={cover} alt={coverAlt} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1100px) 760px, 92vw" loading="eager" />
          </div>
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="side" aria-label="Event details">
      <div class="card">
        <h2>Event details</h2>
        <dl>
          <div>
            <dt><Icon name="calendar" size={18} /><span class="visually-hidden">Date</span></dt>
            <dd><time datetime={isoDate(date)}>{formatDate(date)}</time></dd>
          </div>
          {
            time && (
              <div>
                <dt>
                  <Icon name="clock" size={18} />
                  <span class="visually-hidden">Time</span>
                </dt>
                <dd>{time}</dd>
              </div>
            )
          }
          <div>
            <dt><Icon name="pin" size={18} /><span class="visually-hidden">Place</span></dt>
            <dd>{location}</dd>
          </div>
        </dl>
        <p class="ask">
          Questions about this event?{' '}
          <a href={site.facebook} target="_blank" rel="noopener">Message us on Facebook</a>
        </p>
      </div>
    </aside>
  </div>

  {
    photos.length > 0 && (
      <section class="gallery band" aria-labelledby="gallery-title">
        <div class="container">
          <h2 id="gallery-title">{`Photos (${photos.length})`}</h2>
          <ul class="masonry">
            {photos.map((p) => (
              <li>
                <button
                  type="button"
                  class="thumb"
                  data-lightbox={`event-${entry.id}`}
                  data-src={p.full}
                  data-alt={p.alt}
                  data-caption={p.caption ?? ''}
                  aria-label={`Open photo: ${p.caption ?? p.alt}`}
                >
                  <Image src={p.src} alt={p.alt} widths={[400, 640, 960]} sizes="(min-width: 1100px) 380px, (min-width: 640px) 45vw, 92vw" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: 0.5rem var(--section);
  }

  .cover {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--brand-wash);
    margin-bottom: 2.5rem;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prose {
    max-width: 42rem;
    font-size: 1.075rem;
    line-height: 1.75;
  }

  .prose :global(> * + *) {
    margin-top: 1.2em;
  }

  .prose :global(h2) {
    margin-top: 2em;
    font-family: var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    font-size: var(--text-xl);
  }

  .prose :global(ul) {
    padding-left: 1.2em;
  }

  .prose :global(li + li) {
    margin-top: 0.5em;
  }

  .prose :global(li::marker) {
    color: var(--brand);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--brand);
  }

  /* ---------- details card ---------- */
  .side {
    position: sticky;
    top: 6.5rem;
  }

  .card {
    padding: 1.5rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--amber);
  }

  .card h2 {
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: 1rem;
  }

  dl {
    display: grid;
    gap: 0.9rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  dl > div {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  dt {
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--brand-wash);
    color: var(--brand);
  }

  dl > div {
    align-items: center;
  }

  dd {
    color: var(--ink);
    font-weight: 500;
    line-height: 1.45;
  }

  .ask {
    font-size: 0.925rem;
    color: var(--ink-muted);
  }

  .ask a {
    color: var(--brand);
    font-weight: 600;
  }

  /* ---------- gallery ---------- */
  .gallery {
    padding-block: var(--section);
  }

  .gallery h2 {
    font-family: var(--font-display);
    font-stretch: 112%;
    letter-spacing: -0.02em;
    font-size: var(--text-3xl);
    margin-bottom: 2rem;
  }

  .masonry {
    columns: 3 16rem;
    column-gap: 0.75rem;
    list-style: none;
    padding: 0;
  }

  .masonry li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .thumb {
    display: block;
    width: 100%;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--brand-wash);
  }

  .thumb :global(img) {
    width: 100%;
    transition: transform 0.6s var(--ease);
  }

  .thumb:hover :global(img) {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
      order: -1;
    }
  }
</style>
